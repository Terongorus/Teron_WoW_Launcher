<Window x:Class="TeronWoWLauncher.Dialogs.InstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Install Vanilla Client" Height="280" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">

    <shell:WindowChrome.WindowChrome>
        <!-- Same close-only, locked custom chrome as AddAddonDialog: no icon/title text/minimize/
             maximize, CaptionHeight="0" so no part of the window is draggable, ResizeMode="NoResize"
             plus ResizeBorderThickness="0" so it can't be resized either — fixed size and position,
             exactly as placed by WindowStartupLocation="CenterOwner". -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- The app-wide TextBlock/TextBox/Button styles (App.xaml) cover this dialog too — no local overrides here. -->

    <Border Margin="16" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    Width="48" Height="36" HorizontalAlignment="Right" Click="OnCancel" ToolTip="Close"/>

            <Grid Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="Install the World of Warcraft 1.12.1 client"
                           Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Style="{StaticResource MicroText}"
                           Text="Choose a folder. The client and everything this installation manages (addons, tweaks, DLLs) will live there — the launcher itself doesn't need to be inside it, and can manage other installations too."
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;"
                            Margin="8,0,0,0" Click="OnBrowse" ToolTip="Browse for a folder"/>
                    <TextBox x:Name="FolderBox"/>
                </DockPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="InstallButton" Content="Install" Click="OnInstall"
                            Background="#3B7D3B" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
