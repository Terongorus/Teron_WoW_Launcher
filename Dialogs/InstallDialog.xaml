<Window x:Class="TeronWoWLauncher.Dialogs.InstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Vanilla Client" Height="220" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8D0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="#EDEDED"/>
        </Style>
        <!-- The app-wide Button style (App.xaml) covers this dialog too — no local override here. -->
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Install the vanilla 1.12.1 client" FontSize="16" FontWeight="Bold"
                   Foreground="#E6C067" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Choose a folder. It becomes your WoW home directory — the launcher, the client, and everything it manages will live there."
                   TextWrapping="Wrap" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,14"/>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;"
                    Margin="8,0,0,0" Click="OnBrowse" ToolTip="Browse for a folder"/>
            <TextBox x:Name="FolderBox"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
            <Button x:Name="InstallButton" Content="Install" Click="OnInstall"
                    Background="#3B7D3B" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
