<Window x:Class="TeronWoWLauncher.Dialogs.AddonDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Height="720" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">

    <shell:WindowChrome.WindowChrome>
        <!-- Same close-only, locked custom chrome as every other dialog (see MarkdownPreviewDialog's
             own comment for the full rationale) — no icon/title text/minimize/maximize, fixed size
             and position, rounded outer corners matching the inner card. -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- ExpandedMarkdownViewer (App.xaml) covers this dialog too — no local override here. -->

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="OnHyperlink"/>
    </Window.CommandBindings>

    <Border Margin="16" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" Click="OnCloseClicked" ToolTip="Close"/>

            <TextBlock x:Name="RepoLinkText" DockPanel.Dock="Top" Margin="16,12,16,0" Visibility="Collapsed">
                <Hyperlink x:Name="RepoLink" RequestNavigate="OnRepoLinkNavigate" Foreground="#E6C067">
                    <Run x:Name="RepoLinkRun" Text="View on GitHub"/> &#x2197;
                </Hyperlink>
            </TextBlock>

            <CheckBox DockPanel.Dock="Bottom" x:Name="IgnoreUpdatesCheck"
                      Content="Ignore updates for this addon"
                      Margin="16,0,16,16"
                      ToolTip="Even if a newer remote version is found, this addon won't be flagged as updatable."/>

            <markdig:MarkdownViewer x:Name="Viewer" Style="{StaticResource ExpandedMarkdownViewer}"
                                     Margin="16,0,16,16"/>
        </DockPanel>
    </Border>
</Window>
