<Window x:Class="TeronWoWLauncher.Dialogs.RenameAddonFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rename Addon Folder" Height="320" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">

    <shell:WindowChrome.WindowChrome>
        <!-- Same close-only, locked custom chrome as every other dialog (see ConfirmDialog's own
             comment for the full rationale). -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="16" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    Width="48" Height="36" HorizontalAlignment="Right" Click="OnCancel" ToolTip="Close"/>

            <Grid Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="Rename Addon Folder" Margin="0,0,0,14"/>

                <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="Folder" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="2" x:Name="FolderPicker" SelectionChanged="OnFolderChanged"/>

                <TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" Text="New folder name" Margin="0,12,0,4"/>
                <TextBox Grid.Row="4" x:Name="NewNameBox"/>

                <TextBlock Grid.Row="5" x:Name="ErrorText" Style="{StaticResource CaptionText}"
                           Foreground="#E5484D" TextWrapping="Wrap" VerticalAlignment="Top"
                           Margin="0,8,0,0" Visibility="Collapsed"/>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="RenameButton" Content="Rename" Click="OnRename" BorderThickness="0"
                            Background="{StaticResource AddActionBrush}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
