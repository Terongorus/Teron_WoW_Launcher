<Window x:Class="TeronWoWLauncher.Dialogs.AddAddonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Add Addon" Height="260" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">

    <shell:WindowChrome.WindowChrome>
        <!-- Same close-only custom chrome as MarkdownPreviewDialog: no icon/title text/minimize/
             maximize, just a close button, with the window's own outer corners rounded to match the
             inner card. CaptionHeight="0" means no part of the window is a draggable "caption" area —
             combined with ResizeMode="NoResize" (and ResizeBorderThickness="0"), the dialog can't be
             moved or resized at all; it stays exactly where CenterOwner placed it, at its XAML size. -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- The app-wide TextBlock/TextBox/Button styles (App.xaml) cover this dialog too — no local overrides here. -->

    <Border Margin="16" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <Button DockPanel.Dock="Top" Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    Width="48" Height="36" HorizontalAlignment="Right" Click="OnCancel" ToolTip="Close"/>

            <Grid Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="Add an addon"
                           Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Style="{StaticResource MicroText}"
                           Text="Paste a GitHub repo URL, a Legacy-WoW or Warperia addon page URL, a direct archive URL, or browse to a local .zip/.rar/.7z file."
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;"
                            Click="OnBrowseFile" Margin="8,0,0,0" ToolTip="Browse for an addon archive"/>
                    <TextBox x:Name="UrlBox"/>
                </DockPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="AddButton" Content="Add" Click="OnAdd"
                            Background="#3B7D3B" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
