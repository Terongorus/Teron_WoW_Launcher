<Window x:Class="TeronWoWLauncher.Dialogs.MarkdownPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Height="720" Width="820" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1F">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="OnHyperlink"/>
    </Window.CommandBindings>

    <Border Margin="16" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1"
            CornerRadius="6" Padding="16">
        <markdig:MarkdownViewer x:Name="Viewer"/>
    </Border>
</Window>
