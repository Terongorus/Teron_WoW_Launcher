<Window x:Class="TeronWoWLauncher.Dialogs.UpdateConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Height="260" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1F">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8D0"/>
        </Style>
        <!-- The app-wide Button style (App.xaml) covers this dialog too — no local override here. -->
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="A different client archive is available" FontSize="16" FontWeight="Bold"
                   Foreground="#E6C067" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#101014" CornerRadius="6" Padding="12">
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Not now" Click="OnCancel" Margin="0,0,8,0"/>
            <Button x:Name="UpdateButton" Content="Update" Click="OnUpdate"
                    Background="#3B7D3B" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
