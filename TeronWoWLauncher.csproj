<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TeronWoWLauncher</RootNamespace>
    <AssemblyName>TeronWoWLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!--
      WoW.exe (1.12.1) is a 32-bit binary. This launcher MUST run as a 32-bit
      process: the DLL injection uses CreateRemoteThread with the address of
      kernel32!LoadLibraryW, which is only valid in the target when both
      processes share the same bitness. Do NOT change this to x64 or AnyCPU.
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>

    <!-- Product identity / display. Title bar reads these live from assembly metadata. -->
    <Product>Teron WoW Launcher (TWL)</Product>
    <Company>Teronverse</Company>
    <Authors>Kaloyan Kolev</Authors>
    <Version>1.11.0</Version>
    <!-- Keep AssemblyInformationalVersion clean ("1.11.0", not "1.11.0+<gitsha>"). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Shown in Explorer/taskbar/Alt+Tab (and used as MainWindow's own icon below, since the
         custom title bar has no native caption icon slot to pick it up from automatically). -->
    <ApplicationIcon>game.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    DPAPI (System.Security.Cryptography.ProtectedData) is provided in-box by the
    net10.0-windows framework, so no PackageReference is required.
  -->

  <ItemGroup>
    <!-- Extracts .rar/.7z addon archives (the BCL only handles .zip). Pure-managed, MIT. -->
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- Real git clone/fetch for GitHub-tracked addons (see GitHubAddonSource) — avoids the
         api.github.com REST rate limit (60/hr) entirely, since git's smart-HTTP protocol isn't
         subject to it. Verified its native git2-*.dll loads correctly under this project's
         self-contained single-file win-x86 publish (bundled the same way WPF's own native
         dependencies already are). MIT. -->
    <PackageReference Include="LibGit2Sharp" Version="0.30.0" />
    <!-- Renders README.md/CHANGELOG.md as a WPF FlowDocument on the Home tab. MIT. -->
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as a WPF pack resource so MainWindow's Icon="game.ico" resolves at runtime,
         independent of ApplicationIcon above (which only covers the compiled exe's own Win32 icon). -->
    <Resource Include="game.ico" />
    <!-- Body background art (MainWindow's BodyBackgroundImage) — one is picked at random per launch.
         Pre-cropped to a consistent 16:9 and downscaled/recompressed from the original multi-MB source
         paintings, so all of them together add a few MB instead of tens of MB. Keep
         MainWindow.xaml.cs's BodyBackgroundImageCount in sync with how many background_N.jpg files
         exist here. -->
    <Resource Include="Artwork\background_*.jpg" />
  </ItemGroup>

  <!--
    Builds the Inno Setup installer right after `dotnet publish`/VS Publish finishes writing the
    self-contained output, so publishing the win-x86 profile (the only one - this app is x86-only)
    produces a ready-to-distribute "TeronWoWLauncherSetup-x86.exe" in bin\InstallerPackage with no
    extra steps. No-ops (with a warning) if Inno Setup isn't installed, so it never breaks a plain
    build/publish.

    Everything here is computed inside the target body, evaluated when the target actually runs,
    rather than in a top-level PropertyGroup: publish-profile properties like RuntimeIdentifier and
    SelfContained aren't populated yet during the project's normal (early) static evaluation of
    top-level PropertyGroups - only once the publish pipeline itself is running.
  -->
  <Target Name="BuildInnoSetupInstaller" AfterTargets="Publish">
    <PropertyGroup>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe')">$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
      <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' AND Exists('$(ProgramFiles)\Inno Setup 6\ISCC.exe')">$(ProgramFiles)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    </PropertyGroup>

    <Exec Command="&quot;$(InnoSetupCompiler)&quot; /DMyAppVersion=$(FileVersion) &quot;$(MSBuildProjectDirectory)\Installer\TeronWoWLauncher.iss&quot;"
          Condition="'$(RuntimeIdentifier)' == 'win-x86' AND '$(SelfContained)' == 'true' AND '$(InnoSetupCompiler)' != ''" />
    <Warning Text="Inno Setup (ISCC.exe) was not found in the usual install locations; skipping installer build. Install it with 'winget install JRSoftware.InnoSetup' to enable this step."
              Condition="'$(RuntimeIdentifier)' == 'win-x86' AND '$(SelfContained)' == 'true' AND '$(InnoSetupCompiler)' == ''" />
  </Target>

</Project>
