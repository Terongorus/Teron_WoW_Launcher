<Application x:Class="TeronWoWLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
          Markdig.Wpf renders headings with a hardcoded black Foreground and gives code spans a light
          gray background — both invisible/unreadable against this app's dark theme. These override the
          library's own named style-resource keys (its built-in theming extension point, defined in its
          Themes/generic.xaml), which take precedence here since Application-level resources are
          resolved before a control's default theme dictionary. Kept at the Application level (not just
          MainWindow) so every window that shows a MarkdownViewer — including the expanded preview
          dialog — gets the same readable colors.
        -->
        <Style TargetType="{x:Type FlowDocument}" x:Key="{x:Static markdig:Styles.DocumentStyleKey}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#DADADD"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading1StyleKey}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#E6C067"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading2StyleKey}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#E6C067"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading3StyleKey}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading4StyleKey}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#C8C8D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="{x:Type Run}" x:Key="{x:Static markdig:Styles.CodeStyleKey}">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="{x:Type Hyperlink}" x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}">
            <Setter Property="Foreground" Value="#E6C067"/>
        </Style>
        <Style TargetType="{x:Type Section}" x:Key="{x:Static markdig:Styles.QuoteBlockStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
        </Style>
        <Style TargetType="{x:Type Line}" x:Key="{x:Static markdig:Styles.ThematicBreakStyleKey}">
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="#4A4A54"/>
        </Style>
        <Style TargetType="{x:Type Table}" x:Key="{x:Static markdig:Styles.TableStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="CellSpacing" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TableCell}" x:Key="{x:Static markdig:Styles.TableCellStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="1,1,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!--
          Every button in the app, everywhere (MainWindow and every dialog) — defined once, here, so
          nothing shadows it. A per-window "TargetType=Button" style would take precedence over this
          one (Window resources are checked before Application resources), so no window is allowed to
          define its own implicit Button style anymore; only per-instance overrides (e.g. a Play
          button's own Background) are set locally.

          Replaces the OS's default Fluent/Aero2 button chrome — which shows a generic light/blue
          overlay on hover that clashed with this app's dark, gold-accented theme — with our own: a
          semi-transparent white overlay that lightens whatever Background the button actually has
          (so this works unmodified for the plain gray toolbar buttons AND the green Play button AND
          the blue per-addon Update button), plus a gold border on hover/press/keyboard-focus matching
          the accent color used everywhere else (nav underline, headings, hyperlinks, the realmlist flash).
        -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#33333A"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True"/>
                            <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="6"/>
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.10"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Icon-only toolbar buttons (Segoe Fluent Icons, built into Windows 10/11 — no extra font
          asset needed). Used for common, universally-recognizable actions (add/remove/refresh/move/
          browse/etc.); a ToolTip carries the explanation. Based on the app-wide Button style above, so
          it gets the same hover/press/focus behavior for free.
        -->
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
