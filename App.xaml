<Application x:Class="TeronWoWLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
          The app's whole text hierarchy, in one place: one dedicated size/weight/color per role,
          used identically on every tab and dialog instead of each screen inventing its own
          FontSize/FontWeight/Foreground combination. Mirrors the Markdig heading scale below (H1=26,
          H2=20, both gold/bold) so rendered Markdown and native UI chrome read as the same system.

            Heading1Text — the app's own title (top-left corner). Rare; one per window at most.
            Heading2Text — a screen's primary heading ("How to use", "Login", every dialog's title).
            Heading3Text — a group label within a screen ("Installation directory", "Ignored DLLs").
            BodyText     — plain body/field-label text. Apply explicitly (see BodyText below for why).
            CaptionText  — secondary inline readouts (status line, realmlist label, addon version).
            MicroText    — small explanatory blurbs under a heading (tab/dialog descriptions).

          Most control types get an explicit FontFamily too, instead of relying on the implicit OS
          default, so the font is a deliberate choice recorded in one place (AppFontFamily) rather
          than an accident of whatever font a fresh WPF project happens to default to. TextBlock and
          Button are the deliberate exceptions — see the BodyText and Button styles below for why.
        -->
        <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

        <!--
          The app's action-color palette, one brush per verb, shared by every Add/Install/Update/
          Remove icon button across every tab (DLLs, MPQ Patches, Addons Installed, Addons Browse)
          plus the Play button's own state colors (MainWindow.xaml.cs) — same four values, kept as
          separate C# constants there rather than pulled from here, since the Play button predates
          this shared-resource set and already worked correctly; these exist so every *other* button
          has one place to reference instead of each one hardcoding its own hex string (which is
          exactly how Add/Update/Remove buttons ended up inconsistent - see issue #14).
        -->
        <SolidColorBrush x:Key="AddActionBrush" Color="#3B7D3B"/>
        <SolidColorBrush x:Key="InstallActionBrush" Color="#2E6DA4"/>
        <SolidColorBrush x:Key="UpdateActionBrush" Color="#C9922B"/>
        <SolidColorBrush x:Key="RemoveActionBrush" Color="#A83A3A"/>

        <Style x:Key="Heading1Text" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E6C067"/>
        </Style>
        <Style x:Key="Heading2Text" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E6C067"/>
        </Style>
        <Style x:Key="Heading3Text" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#DADADD"/>
        </Style>
        <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#8A8A92"/>
        </Style>
        <Style x:Key="MicroText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8A8A92"/>
        </Style>

        <!--
          Shared page-card look for a tab's content: a fixed-width, horizontally centered dark card, so
          content reads as one consistent column instead of stretching edge-to-edge when the window is
          maximized. Tweaks and Settings apply this directly to their one root Border; MPQ Patches and
          Addons use the split PageCardTopStyle/PageCardBottomStyle pair below instead (they need a
          pinned header above a separately-scrollable list). DLLs isn't part of this family — it's a
          genuinely wide side-by-side browse layout, not a narrow form, so it intentionally stays
          full-width; Log needs the pinned-header-over-list split but also needs real width (long
          timestamps/messages/stack traces), so it uses the WideCardTopStyle/WideCardBottomStyle pair
          further below instead — same split structure and visual treatment, no MaxWidth cap.

          HorizontalAlignment is Stretch, not Center: Stretch makes the Border fill the width its
          parent offers, and MaxWidth then clips that down to the cap — at which point WPF centers the
          clipped element automatically. Center alone would size the Border to its own content's
          natural width instead, so it would never reach the cap and every tab's card would end up a
          different width depending on what that tab happens to contain.
        -->
        <Style x:Key="PageCardStyle" TargetType="{x:Type Border}">
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="Margin" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!--
          Split card for tabs that need a pinned header above a scrollable list (MPQ Patches, Addons):
          two Borders stacked in a plain Auto/Star Grid — Top holds the header/buttons and is never
          inside a ScrollViewer, so it can't move; Bottom sits inside a ScrollViewer whose OWN scrollbar
          is hidden (see the tab XAML: MainWindow drives scrolling through a separate, standalone
          ScrollBar in a dedicated Grid column instead). Both Borders are Auto-height and top-aligned,
          so a short list produces a short card (no forced fill-to-bottom dead space); a long list grows
          past the Star row's available height and that standalone ScrollBar starts scrolling just the
          list while the header stays put. Rounded/bordered only on the edges that don't touch, so the
          pair reads as one seamless card.

          Both styles use the same symmetric Margin — width/centering no longer needs to account for a
          scrollbar at all here, because MainWindow.xaml keeps the scrollbar out of both Borders' own
          width calculation entirely (it lives in a sibling Grid column, sized via SharedSizeGroup so it
          can never drift between Top and Bottom regardless of how wide the real scrollbar renders).
        -->
        <Style x:Key="PageCardTopStyle" TargetType="{x:Type Border}">
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="Margin" Value="24,24,24,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="24,24,24,16"/>
        </Style>
        <Style x:Key="PageCardBottomStyle" TargetType="{x:Type Border}">
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="Margin" Value="24,0,24,24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="24,16,24,24"/>
        </Style>

        <!--
          Full-width twin of PageCardTopStyle/PageCardBottomStyle, for tabs whose content doesn't fit
          a narrow 720px form column — the Log tab's lines (timestamps, full exception text) need
          real width, the same reason DLLs stays outside the PageCardStyle family entirely. Same
          pinned-header-over-scrollable-list split and the same visual treatment (background/border/
          corner-radius/padding), just without the MaxWidth cap; margin/padding match DLLs' own
          Margin="16" full-width convention instead of the 24px used by the narrow family.
        -->
        <Style x:Key="WideCardTopStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="16,16,16,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Padding" Value="16,16,16,10"/>
        </Style>
        <Style x:Key="WideCardBottomStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="16,0,16,16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="16,10,16,16"/>
        </Style>

        <!--
          Markdig.Wpf renders headings with a hardcoded black Foreground and gives code spans a light
          gray background — both invisible/unreadable against this app's dark theme. These override the
          library's own named style-resource keys (its built-in theming extension point, defined in its
          Themes/generic.xaml), which take precedence here since Application-level resources are
          resolved before a control's default theme dictionary. Kept at the Application level (not just
          MainWindow) so every window that shows a MarkdownViewer — including the expanded preview
          dialog — gets the same readable colors. Sizes/colors here match Heading1Text/Heading2Text
          above deliberately, so rendered Markdown headings read as the same tier as native ones.
        -->
        <Style TargetType="{x:Type FlowDocument}" x:Key="{x:Static markdig:Styles.DocumentStyleKey}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="#DADADD"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading1StyleKey}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#E6C067"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading2StyleKey}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#E6C067"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading3StyleKey}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.Heading4StyleKey}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#C8C8D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style TargetType="{x:Type Paragraph}" x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="{x:Type Run}" x:Key="{x:Static markdig:Styles.CodeStyleKey}">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="{x:Type Hyperlink}" x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}">
            <Setter Property="Foreground" Value="#E6C067"/>
        </Style>
        <Style TargetType="{x:Type Section}" x:Key="{x:Static markdig:Styles.QuoteBlockStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
        </Style>
        <Style TargetType="{x:Type Line}" x:Key="{x:Static markdig:Styles.ThematicBreakStyleKey}">
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="#4A4A54"/>
        </Style>
        <Style TargetType="{x:Type Table}" x:Key="{x:Static markdig:Styles.TableStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="CellSpacing" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TableCell}" x:Key="{x:Static markdig:Styles.TableCellStyleKey}">
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="1,1,0,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!--
          MarkdownViewer's default template (used everywhere else via CompactMarkdownViewer/plain
          usage) shows a built-in zoom/print toolbar (IsToolBarVisible defaults to true) — an OS-
          styled strip that clashes with this app's chrome and makes no sense floating over a
          full-size document. This is otherwise the library's stock FlowDocumentScrollViewer
          presentation (real scrollbars, unlike CompactMarkdownViewer's hidden ones), so its internal
          ScrollViewer/ScrollBar still pick up the app-wide modern scrollbar style automatically.
          App-wide (not per-dialog) since both MarkdownPreviewDialog and AddonDetailsDialog use it.
        -->
        <Style x:Key="ExpandedMarkdownViewer" TargetType="{x:Type markdig:MarkdownViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type markdig:MarkdownViewer}">
                        <FlowDocumentScrollViewer Document="{TemplateBinding Document}" IsToolBarVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Every TextBlock/CheckBox/TextBox/PasswordBox/ListBox in the app, everywhere — defined once,
          here, for the same reason as the Button style below: a per-window "TargetType=X" style
          would shadow this one (Window resources are checked before Application resources), so no
          window or dialog is allowed to define its own implicit style for these types anymore; only
          per-instance overrides are set locally. TextBox/PasswordBox/ListBox get rounded corners
          (CornerRadius 6) to match the Button style and the MarkdownViewer preview borders.
        -->
        <!--
          Deliberately named, not implicit (TargetType with no x:Key): an implicit TextBlock style
          applies to every TextBlock in the app, including the ones WPF auto-generates internally to
          host a Button/RadioButton/CheckBox's plain string Content (e.g. an icon glyph's "&#xE921;",
          or a nav label's "Home"). A Style setter always outranks inherited value in WPF's property
          precedence order — regardless of how specific or high-precedence the ancestor's own value
          is — so an implicit TextBlock style silently overrides whatever FontSize/Foreground/
          FontFamily that control's own style meant its content to have (this bit both the icon fonts
          and NavButtonStyle's FontSize/checked-color before this was made opt-in). Apply this
          explicitly (Style="{StaticResource BodyText}") only on real standalone body text.
        -->
        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#C8C8D0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <!--
                          A horizontal StackPanel gives its children unconstrained width during
                          measure, so a long label never wraps — it just overflows and gets clipped by
                          whatever ancestor happens to cut it off. A Grid column constrains the content
                          column to the actual available width, so TextWrapping (enabled below, scoped
                          to this ContentPresenter's own generated text) can actually take effect —
                          this only affects the label's own line breaks, not how wide any ancestor
                          container is willing to be.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Border x:Name="Bd" Background="#26262B" BorderBrush="#4A4A54"
                                        BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"/>
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                           FontSize="11" Foreground="#1B1B1F" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" x:Name="Content" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6C067"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="#EDEDED"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#5E5E6A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="#EDEDED"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#5E5E6A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          First ComboBox in the app (the Realmlist history dropdown) — same palette as TextBox/
          PasswordBox above (background/border/focus colors), since there's no theme for it to
          inherit otherwise and the stock WPF chrome is light/Aero, which would clash badly here.
          Built from the standard ComboBox template anatomy: PART_EditableTextBox and PART_Popup are
          the exact names ComboBox's own code looks for via OnApplyTemplate, so keyboard/selection
          behavior (arrow keys, Enter, Escape, edit-and-commit) all keep working without needing to
          reimplement any of it here — only the visuals are replaced.
        -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Bd" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True"/>

                            <!-- Shown only when not editable; the editable case below covers this app's one usage. -->
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" Visibility="Collapsed"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                            <!-- Padding="0" is required here, not just cosmetic: this TextBox is still
                                 matched by the app-wide implicit TextBox style (App.xaml), which sets
                                 its own Padding="5,4" - stacked on top of the Margin="{TemplateBinding
                                 Padding}" line below (also 5,4, from the outer ComboBox's own Padding),
                                 that doubled the vertical inset and clipped descenders inside a
                                 fixed-height editable ComboBox (the Realmlist field). A non-editable
                                 ComboBox never hit this, since it shows SelectionBoxItem via
                                 ContentSite's ContentPresenter instead of a real nested TextBox. -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Margin="{TemplateBinding Padding}" Padding="0"
                                     VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Focusable="{TemplateBinding IsEditable}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed"/>

                            <ToggleButton x:Name="ToggleButton" Grid.Column="1"
                                          Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                       Foreground="#9A9AA2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220" Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- The missing half of the above: ContentSite (showing SelectionBoxItem)
                                 starts Collapsed and nothing ever un-collapsed it for the non-editable
                                 case - this template was only ever exercised with IsEditable="True"
                                 (the Realmlist history dropdown) until the Marketplace browser's plain
                                 (non-editable) ComboBoxes hit this latent gap and rendered completely
                                 blank, selected item and all. -->
                            <Trigger Property="IsEditable" Value="False">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5E5E6A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <!-- These three TemplateBindings were missing entirely, so setting
                                 ScrollViewer.VerticalScrollBarVisibility/CanContentScroll on any
                                 ListBox instance silently did nothing - this inner ScrollViewer just
                                 used its own defaults (Visible, CanContentScroll=False) regardless.
                                 Never surfaced before because every existing ListBox (AddonList,
                                 IgnoredDllList, etc.) either sits inside its own outer ScrollViewer
                                 with unconstrained height (nothing to scroll internally, so a stray
                                 Visible scrollbar never showed) or never overflows in the first place -
                                 the Marketplace Browse list is the first one that's both genuinely
                                 height-constrained and needs its internal scrollbar hidden/its
                                 VirtualizingStackPanel to actually virtualize. -->
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Custom window-control buttons (minimize/maximize/close), app-wide — used by any window with
          its own WindowChrome and custom title row (MainWindow, MarkdownPreviewDialog): no background
          fill ever, same treatment as MainWindow's nav labels — only the glyph's Foreground changes on
          hover. Close gets its own style so its hover color can be a soft red instead of white, the
          one universally-expected exception to "no background" feedback.
        -->
        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E5484D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Modern flat scrollbars (thin, borderless track, rounded thumb), app-wide — previously scoped
          to MainWindow's own Window.Resources despite its comment claiming otherwise, so every dialog
          (MarkdownPreviewDialog included) actually fell back to the OS's default scrollbar chrome.
        -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#4A4A54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5E5E6A"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#E6C067"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernScrollRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernScrollRepeatButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernScrollRepeatButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollRepeatButton}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ModernScrollRepeatButton}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          Every button in the app, everywhere (MainWindow and every dialog) — defined once, here, so
          nothing shadows it. A per-window "TargetType=Button" style would take precedence over this
          one (Window resources are checked before Application resources), so no window is allowed to
          define its own implicit Button style anymore; only per-instance overrides (e.g. a Play
          button's own Background) are set locally.

          No FontFamily setter here deliberately: a Button's plain string Content (an icon glyph, a
          label) is hosted by an internally-generated TextBlock that inherits FontFamily from this
          Button. IconButtonStyle relies on exactly that inheritance for "Segoe Fluent Icons" — see
          the BodyText style's comment above for why a Setter here would be worse than no Setter.

          Replaces the OS's default Fluent/Aero2 button chrome — which shows a generic light/blue
          overlay on hover that clashed with this app's dark, gold-accented theme — with our own: a
          semi-transparent white overlay that lightens whatever Background the button actually has
          (so this works unmodified for the plain gray toolbar buttons AND the green Play button AND
          the blue per-addon Update button), plus a gold border on hover/press/keyboard-focus matching
          the accent color used everywhere else (nav underline, headings, hyperlinks, the realmlist flash).
        -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#33333A"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True"/>
                            <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="6"/>
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.10"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Icon-only toolbar buttons (Segoe Fluent Icons, built into Windows 10/11 — no extra font
          asset needed). Used for common, universally-recognizable actions (add/remove/refresh/move/
          browse/etc.); a ToolTip carries the explanation. Based on the app-wide Button style above, so
          it gets the same hover/press/focus behavior for free.
        -->
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!--
          Same "no background ever, only the glyph's color shifts" treatment as the window-control
          buttons, sized for inline use next to a list row instead of a title bar. Used where a
          background box would compete with the row's own content (e.g. the addon list's Details
          button) rather than clearly reading as a toolbar action.
        -->
        <Style x:Key="GhostIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6C067"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
