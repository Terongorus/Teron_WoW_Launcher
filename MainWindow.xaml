<Window x:Class="TeronWoWLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="980" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1F">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8D0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="#EDEDED"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="CaretBrush" Value="#EDEDED"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#33333A"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#4A4A54"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#101014"/>
            <Setter Property="Foreground" Value="#DADADD"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header with the prominent Play button -->
        <Border DockPanel.Dock="Top" Background="#111114" Padding="16,12">
            <Grid>
                <TextBlock x:Name="HeaderText" VerticalAlignment="Center"
                           Foreground="#E6C067" FontSize="22" FontWeight="Bold"/>
                <Button x:Name="PlayButton" Content="PLAY" Click="OnPlayClicked"
                        HorizontalAlignment="Right" Width="170" Height="46"
                        Background="#3B7D3B" Foreground="White" FontSize="18" FontWeight="Bold"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#111114" Padding="14,7">
            <TextBlock x:Name="StatusText" Foreground="#9A9AA2" FontSize="12"/>
        </Border>

        <!-- Body -->
        <TabControl Background="#1B1B1F" BorderThickness="0" Padding="0">
            <TabItem Header="Patches">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Executable patches (rebuilt from a pristine backup, in fixed order)"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="1. Signature Removal → 2. VanillaTweaks. Toggling or adjusting any patch rebuilds WoW.exe from the untouched backup."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel x:Name="PatchesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="DLLs">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="DLLs injected on launch (dlls.txt, load order top → bottom)" FontWeight="SemiBold"/>
                        <TextBlock Text="Add DLLs placed in the game folder. Only files that exist are injected."
                                   Foreground="#8A8A92" FontSize="11"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="DllList"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add DLL…" Click="OnAddDll"/>
                        <Button Content="Remove" Click="OnRemoveDll" Margin="8,0,0,0"/>
                        <Button Content="Move Up" Click="OnMoveDllUp" Margin="8,0,0,0"/>
                        <Button Content="Move Down" Click="OnMoveDllDown" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="MPQ Patches">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Custom MPQ patches in Data\ (patch-A.mpq … patch-Z.mpq)" FontWeight="SemiBold"/>
                        <TextBlock Text="Uncheck to disable (renames to _patch-X.mpq). Base Blizzard patches are not shown."
                                   Foreground="#8A8A92" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MpqPanel"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add MPQ…" Click="OnAddMpq"/>
                        <Button Content="Refresh" Click="OnRefreshMpq" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Addons">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Addons (installed into Interface\AddOns)" FontWeight="SemiBold"/>
                        <TextBlock Text="Add by GitHub repo URL, a direct .zip URL, or a local .zip file."
                                   Foreground="#8A8A92" FontSize="11"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Add from file…" Click="OnAddAddonFromFile" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Add from URL" Click="OnAddAddonFromUrl" Margin="8,0,0,0"/>
                        <TextBox x:Name="AddonUrlBox"/>
                    </DockPanel>
                    <ListBox Grid.Row="2" x:Name="AddonList" DisplayMemberPath="Display"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Remove selected" Click="OnRemoveAddon"/>
                        <Button Content="Update selected" Click="OnUpdateAddon" Margin="8,0,0,0"/>
                        <Button Content="Refresh" Click="OnRefreshAddons" Margin="8,0,0,0"/>
                        <TextBlock x:Name="AddonStatusText" Foreground="#8A8A92" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Install / Update">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="Download &amp; install the vanilla 1.12.1 client" FontWeight="SemiBold"/>
                        <TextBlock Text="The whole base client is a single download. The folder you pick becomes your WoW home directory."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="Install folder"/>
                        <DockPanel Margin="0,4,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0"
                                    Click="OnBrowseInstallFolder"/>
                            <TextBox x:Name="InstallFolderBox"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" x:Name="InstallStatusText" Foreground="#8A8A92" FontSize="11"
                               Margin="0,0,0,10" MaxWidth="660" HorizontalAlignment="Left" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="3" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="Client download URL (advanced — override for another server's client zip)"/>
                        <TextBox x:Name="ClientUrlBox" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="4" x:Name="InstallProgressBar" Height="18" Minimum="0" Maximum="100"
                                 MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,10"
                                 Background="#101014" Foreground="#3B7D3B" BorderBrush="#3A3A42"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                        <Button x:Name="InstallButton" Content="Download / Install" Click="OnInstallClicked"/>
                        <Button x:Name="CancelInstallButton" Content="Cancel" Click="OnCancelInstall"
                                Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Login &amp; Game">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="Game folder (the folder that contains WoW.exe)"/>
                        <DockPanel Margin="0,4,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0"
                                    Click="OnBrowseGameFolder"/>
                            <TextBox x:Name="GameFolderBox"/>
                        </DockPanel>
                        <TextBlock x:Name="GameFolderHint" Foreground="#8A8A92" FontSize="11"/>

                        <CheckBox x:Name="AutoLoginCheck" Content="Enable auto-login" Margin="0,18,0,0"/>

                        <TextBlock Text="Account" Margin="0,14,0,4"/>
                        <TextBox x:Name="AccountBox"/>

                        <TextBlock Text="Password" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="PasswordBoxInput"/>
                        <CheckBox x:Name="SavePasswordCheck"
                                  Content="Remember password (encrypted on this PC with Windows DPAPI)"/>

                        <TextBlock Text="Login delay after the game window appears (ms)" Margin="0,14,0,4"/>
                        <TextBox x:Name="DelayBox" Width="130" HorizontalAlignment="Left"/>

                        <TextBlock Text="Realmlist (any private vanilla server, e.g. logon.myserver.com)" Margin="0,14,0,4"/>
                        <TextBox x:Name="RealmlistBox"/>

                        <Button Content="Save settings" Click="OnSaveSettings"
                                Width="130" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log">
                <Border Background="#101014" Margin="8">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C8C8D0"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
