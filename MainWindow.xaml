<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:svc="clr-namespace:TeronWoWLauncher.Services.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" x:Class="TeronWoWLauncher.MainWindow"
        Height="700" Width="980" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="game.ico"
        Background="#1B1B1F">

  <shell:WindowChrome.WindowChrome>
    <!--
      Replaces the default Windows title bar/icon/min-max-close with our own row (below), while
      keeping the OS's resize handles, Aero Snap (drag-to-edge, Win+arrow), and drop shadow — those
      come from WindowChrome itself, not from the native caption we're hiding. CaptionHeight must
      match the custom title bar row's own Height so the OS treats exactly that strip as the
      draggable/double-click-to-maximize caption area; the three buttons inside opt back out of that
      via WindowChrome.IsHitTestVisibleInChrome so clicks register as clicks, not drags.
    -->
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                         UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <svc:ScrollableToVisibilityConverter x:Key="ScrollableToVis"/>
    <svc:TabScrollBarVisibilityConverter x:Key="TabScrollBarVis"/>
    <svc:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
    <svc:ProgressBarFillWidthConverter x:Key="ProgressBarFillWidth"/>
    <svc:RoundedRectClipConverter x:Key="RoundedRectClip"/>
    <svc:ProgressBarFillClipConverter x:Key="ProgressBarFillClip"/>
    <svc:ProgressBarSparkMarginConverter x:Key="ProgressBarSparkMargin"/>

    <!-- The app-wide TextBlock/CheckBox/TextBox/PasswordBox/ListBox/Button/window-control-button
         styles (App.xaml) cover this window too — no local overrides here, except MarketplaceListStyle
         below. -->

    <!-- MarketplaceList's own override of the shared ListBox style/template (App.xaml): same visuals,
         but with VerticalScrollBarVisibility/CanContentScroll hardcoded directly on the inner
         ScrollViewer instead of routed through TemplateBinding to the ScrollViewer.* attached
         properties set on the ListBox instance - that TemplateBinding chain did not actually suppress
         the internal scrollbar or engage virtualization in practice, so this sidesteps it entirely
         for the one list that actually needs it (this is the height-constrained ~700-entry Browse
         results list; every other ListBox in the app never overflows its own unconstrained-height
         container, so the shared style's behavior never mattered for them). -->
    <Style x:Key="MarketplaceListStyle" TargetType="{x:Type ListBox}">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
      <Setter Property="Background" Value="#101014"/>
      <Setter Property="Foreground" Value="#DADADD"/>
      <Setter Property="BorderBrush" Value="#3A3A42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBox}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" SnapsToDevicePixels="True">
              <!-- HorizontalScrollBarVisibility="Disabled" matters beyond just suppressing a
                   horizontal bar: a ScrollViewer only offers its child INFINITE width in a given
                   axis when scrolling is enabled there. Leaving it unset let the virtualizing panel
                   measure each row against infinite width, so the unconstrained Name+Author
                   StackPanel (no MaxWidth, unlike the Description TextBlock which does have one)
                   never wrapped and just kept growing - stretching every row and forcing the whole
                   list to scroll sideways, most visible on Warperia entries (which have real author
                   text; Legacy-WoW entries never do, so they happened not to trigger it). Disabling
                   it here forces rows to be measured against the real, finite viewport width, which
                   is what makes wrapping work at all. -->
              <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                            CanContentScroll="True" VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- MainProgressBar's own style: rounded track + a diagonal-stripe-animated indicator instead of
         a static flat-colored rectangle, so it visibly reads as "actively working" rather than just a
         colored bar that happens to change width. Width-based indicator sizing
         (ProgressBarFillWidthConverter), not a RenderTransform ScaleTransform, so the tiled stripe
         pattern stays a fixed visual size regardless of fill percentage - scaling the whole indicator
         would squash the stripes thinner as the fill percentage dropped. When IsIndeterminate, the
         converter returns the full track width so the whole bar animates continuously (used by the
         patch-apply/backup-verify flows, which have no known duration or byte count to report). The
         stripe brush is a translucent white overlay, not a hardcoded color, so it reads correctly
         over whichever state color MainProgressBar.Foreground is set to (Play green/Install blue/
         Update gold) without needing per-color tuning. -->
    <Style x:Key="AnimatedProgressBarStyle" TargetType="{x:Type ProgressBar}">
      <Setter Property="Background" Value="#101014"/>
      <Setter Property="BorderBrush" Value="#3A3A42"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ProgressBar}">
            <Grid>
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"/>
              <!-- ClipToBounds clips to the plain rectangular bounding box, NOT to CornerRadius -
                   Border doesn't auto-clip its Child to its own rounded corners, which let the
                   square-cornered indicator/stripe visibly poke past the track's rounded corners.
                   An explicit rounded-rect Clip geometry (RoundedRectClipConverter), sized to this
                   Border's own runtime ActualWidth/Height, is the actual fix. -->
              <Border x:Name="ClipContainer" Margin="{TemplateBinding BorderThickness}">
                <Border.Clip>
                  <MultiBinding Converter="{StaticResource RoundedRectClip}" ConverterParameter="5">
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                  </MultiBinding>
                </Border.Clip>
                <Grid>
                  <!-- Solid color fill - a plain color has no pattern to desync, so resizing this on
                       every progress tick (unlike the stripe overlay below) is harmless. -->
                  <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                          Background="{TemplateBinding Foreground}">
                    <Border.Width>
                      <MultiBinding Converter="{StaticResource ProgressBarFillWidth}">
                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="IsIndeterminate" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                      </MultiBinding>
                    </Border.Width>
                  </Border>

                  <!-- Stripe overlay: a CONSTANT full-track-size Rectangle (never resized as progress
                       updates), with only its Clip growing to reveal more of it - the tile pattern's
                       own coordinate space is stable, so its rasterization never has to re-anchor.
                       Sizing the Rectangle itself to the fill width directly (the original approach)
                       visibly seamed mid-bar instead of just at the trailing edge, confirmed via a
                       screenshot (2026-07-19) - a tiled DrawingBrush's rasterization apparently doesn't
                       stay consistent across frequent per-tick resizes while its scroll transform is
                       also animating. Clipping instead of resizing sidesteps that entirely. -->
                  <!-- Fill is built entirely in code-behind (MainWindow.xaml.cs,
                       OnMainProgressBarLoaded) as one continuous non-tiled geometry with many
                       explicit repeated stripes, not a DrawingBrush TileMode="Tile" - a real,
                       reproducing mid-bar seam persisted (confirmed via screenshot, 2026-07-19) even
                       after removing the per-tick resize that was the first suspected cause,
                       pointing at WPF's own tiled-brush rasterization as the actual source rather
                       than anything about the resize/clip approach. One continuous hand-built
                       geometry has no tile boundary for that to happen across. -->
                  <Rectangle x:Name="PART_StripeOverlay">
                    <Rectangle.Clip>
                      <MultiBinding Converter="{StaticResource ProgressBarFillClip}">
                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="IsIndeterminate" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                      </MultiBinding>
                    </Rectangle.Clip>
                  </Rectangle>

                  <!-- "Spark"/leading-edge glow: a soft bright vertical band centered on the fill's
                       current edge, transparent-bright-transparent horizontally. IsHitTestVisible=False
                       since it's purely decorative, sitting on top of everything else in this Grid. -->
                  <Rectangle Width="11" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <Rectangle.Margin>
                      <MultiBinding Converter="{StaticResource ProgressBarSparkMargin}" ConverterParameter="11">
                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="IsIndeterminate" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                      </MultiBinding>
                    </Rectangle.Margin>
                    <Rectangle.Fill>
                      <!-- Between the original spread (14px, 0/0.5/1) and the too-tight version
                           (8px, 0.35/0.45-0.55/0.65) - a middle-ground width and falloff. -->
                      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.25"/>
                        <GradientStop Color="#CCFFFFFF" Offset="0.4"/>
                        <GradientStop Color="#CCFFFFFF" Offset="0.6"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.75"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                </Grid>
              </Border>
            </Grid>
            <!-- The stripe-scroll animation is started from code-behind (MainWindow.xaml.cs,
                 StartProgressBarStripeAnimation), not a declarative ControlTemplate.Triggers
                 EventTrigger/Storyboard - Storyboard.TargetName resolution against a name inside this
                 template proved unreliable here (threw InvalidOperationException and crashed the app
                 on load, then again with the same error after renaming the target, 2026-07-19),
                 including on a Loaded event that re-broadcasts during window resize. Calling
                 BeginAnimation directly on the actual TranslateTransform object (found once via
                 Template.FindName after the template is applied) sidesteps namescope resolution
                 entirely and isn't subject to the same failure. -->
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tab headers are hidden; navigation is driven by the header-bar labels below instead. -->
    <Style x:Key="HeaderlessTabControl" TargetType="{x:Type TabControl}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A nav "tab" rendered as a plain clickable label with a gold underline when active. -->
    <Style x:Key="NavButtonStyle" TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="#9A9AA2"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                <Setter Property="Foreground" Value="#E6C067"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#DADADD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Compact preview mode for the Home tab's Readme/Changelog boxes: no internal scrollbar and no
      zoom toolbar, since overflow is handled by clicking through to the full-size expand dialog
      instead. This replaces the whole control template, so it's scoped to this window only — the
      expand dialog defines its own (normally-scrolling) MarkdownViewer template.
    -->
    <Style x:Key="CompactMarkdownViewer" TargetType="{x:Type markdig:MarkdownViewer}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type markdig:MarkdownViewer}">
            <FlowDocumentScrollViewer Document="{TemplateBinding Document}"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"
                                      IsToolBarVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DllList/DetectedDllList row: same shape as AddonList's own row (info button on the left,
         name+Summary filling the middle, action buttons on the right, Tag={Binding} so each button's
         click handler knows which DllInfo it's acting on) — Summary already omits any field that
         wasn't present on the file/manual sidecar. The rightmost button doubles as track/untrack:
         its icon/color/tooltip flip based on IsTracked (see the Style below) rather than being two
         separate buttons, since a row is either tracked or not, never both. Ignore only ever applies
         to an untracked row (a tracked DLL can't be hidden), so it's collapsed entirely otherwise. -->
    <DataTemplate x:Key="DllRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource GhostIconButtonStyle}" Content="&#xE946;"
                Tag="{Binding}" Click="OnDllInfoClick" ToolTip="View / edit this DLL's info"
                Margin="0,0,8,0"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                     Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button Grid.Column="2" Content="&#xED1A;"
                Tag="{Binding}" Click="OnIgnoreDllClick" ToolTip="Ignore (won't be suggested again)"
                Margin="8,0,0,0" Width="28" Height="28">
          <Button.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <Button Grid.Column="3" Tag="{Binding}" Click="OnToggleDllTrackedClick"
                Margin="8,0,0,0" Width="28" Height="28">
          <Button.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
              <Setter Property="Content" Value="&#xE710;"/>
              <Setter Property="Background" Value="{StaticResource AddActionBrush}"/>
              <Setter Property="ToolTip" Value="Start tracking (inject on launch)"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                  <Setter Property="Content" Value="&#xE74D;"/>
                  <Setter Property="Background" Value="{StaticResource RemoveActionBrush}"/>
                  <Setter Property="ToolTip" Value="Stop tracking (won't be injected)"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- LogList row: timestamp always muted regardless of severity; the "[LEVEL] message" portion
         takes the severity color via LogLevelToBrushConverter (Debug muted, Info normal body color,
         Warn amber, Error red) — inherited from the TextBlock's own Foreground by every Run below
         that doesn't set its own, except the timestamp Run which overrides it. -->
    <DataTemplate x:Key="LogRowTemplate">
      <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Margin="0,1"
                 Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
        <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss, Mode=OneTime}" Foreground="#6A6A72"/>
        <Run Text="  ["/>
        <Run Text="{Binding LevelDisplay, Mode=OneTime}" FontWeight="SemiBold"/>
        <Run Text="]  "/>
        <Run Text="{Binding Message, Mode=OneTime}"/>
      </TextBlock>
    </DataTemplate>
  </Window.Resources>

  <Window.CommandBindings>
    <CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="OnMarkdownHyperlink"/>
  </Window.CommandBindings>

  <Grid>
  <DockPanel>
    <!-- Header: title + window controls share one row (flush to the top-right corner, no gap
         above it), nav labels centered on the row below. The empty space around the centered
         title in row 0 is still draggable/double-click-to-maximize, since it's within
         WindowChrome's CaptionHeight (kept equal to this row's fixed height) and doesn't opt out
         via IsHitTestVisibleInChrome — only the three buttons do. -->
    <Border DockPanel.Dock="Top" Background="#111114">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <TextBlock x:Name="HeaderText" Style="{StaticResource Heading1Text}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"/>
          <TextBlock x:Name="VersionLabel" Style="{StaticResource MicroText}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE921;"
                    Click="OnMinimizeClicked" ToolTip="Minimize"/>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowControlButtonStyle}" Content="&#xE922;"
                    Click="OnMaximizeRestoreClicked" ToolTip="Maximize"/>
            <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    Click="OnCloseClicked" ToolTip="Close"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="NavPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="16,0,16,12">
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="0"
                                 Content="Home" Click="OnNavClicked" IsChecked="True" Margin="0"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="1"
                                 Content="Tweaks" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="2"
                                 Content="DLLs" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="3"
                                 Content="MPQ Patches" Click="OnNavClicked" Checked="RadioButton_Checked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="4"
                                 Content="Addons" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="5"
                                 Content="Settings" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="6"
                                 Content="Log" Click="OnNavClicked"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer: status + progress bar, and the Play/Install/Update button -->
    <Border DockPanel.Dock="Bottom" Background="#111114" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <!-- Progress bar + its own attached status line/control buttons - a continuously-updating
               readout tied to the bar itself, not a dismissible toast (re-showing one on every
               progress tick would make a just-closed toast pop back open moments later). Two
               separate buttons, not one toggle:
               PauseResumeButton temporarily stops the client download (Install/Update/Repair -
               resumable, since GameInstallService already supports resuming a partial download via
               HTTP Range requests against a fixed temp filename) and CancelDownloadButton
               permanently stops it AND deletes the partial file so a future attempt starts clean.
               The launcher's own self-update download (not resumable - a fresh temp folder every
               attempt) only ever shows CancelDownloadButton, since pausing something that can't
               resume would be misleading. Visibility/tooltips are set explicitly in code alongside
               MainProgressBar's - patch rebuild/backup verification are near-instant and have
               nothing meaningful to pause or cancel, so both stay hidden there. -->
          <Grid>
            <ProgressBar x:Name="MainProgressBar" Height="34" Minimum="0" Maximum="100"
                         Style="{StaticResource AnimatedProgressBarStyle}" Visibility="Collapsed"/>
            <DockPanel Margin="10,0">
              <Button DockPanel.Dock="Right" x:Name="CancelDownloadButton" Content="&#xE711;"
                      FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White" Background="Transparent"
                      BorderThickness="0" Padding="0" Cursor="Hand" Width="24" Height="24" Margin="8,0,0,0"
                      Click="OnCancelDownloadClick" ToolTip="Cancel" Visibility="Collapsed"/>
              <Button DockPanel.Dock="Right" x:Name="PauseResumeButton" Content="&#xE769;"
                      FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White" Background="Transparent"
                      BorderThickness="0" Padding="0" Cursor="Hand" Width="24" Height="24"
                      Click="OnPauseResumeClick" ToolTip="Pause" Visibility="Collapsed"/>
              <TextBlock x:Name="ProgressStatusText" Style="{StaticResource CaptionText}" Foreground="White"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- ShadowDepth=0 makes this an even outline/halo in every direction rather than a
                     directional drop-shadow - improves legibility against the animated striped
                     indicator behind it, which shifts through green/blue/gold depending on state. -->
                <TextBlock.Effect>
                  <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="0.9"/>
                </TextBlock.Effect>
              </TextBlock>
            </DockPanel>
          </Grid>
        </StackPanel>

        <Button Grid.Column="1" x:Name="PlayButton" Content="PLAY" Click="OnPlayClicked"
                        Width="170" Height="46" Background="#3B7D3B" Foreground="White" FontSize="18"
                        FontWeight="Bold" BorderThickness="0" Margin="5, 10, 5, 10"/>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Background="#1B1B1F">
      <!-- One piece of background art, picked at random per launch (see MainWindow.xaml.cs), sitting
           behind every tab's own content. Dimmed low-opacity so it reads as a faint texture rather
           than competing with foreground text — shows through wherever a tab's own content has gaps
           (e.g. an unstyled ScrollViewer), since the TabControl's own Background has no effect anymore
           now that HeaderlessTabControl replaces its template with a bare ContentPresenter. -->
      <Image x:Name="BodyBackgroundImage" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False"/>

      <TabControl x:Name="MainTabs" Style="{StaticResource HeaderlessTabControl}"
                      Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0">

      <!-- 0: Home (Login & Game) -->
      <TabItem d:IsHidden="True">
        <Grid Margin="24">
          <!-- Three equal-width content columns (News, Profile list, Profile settings preview),
               separated by two fixed-width dividers - all three content columns share the same *
               weight so each always gets an equal third of the available width, same as the
               News/Login split already did before this became a 3-column layout. -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left: How to use. Fills the column's real height (no outer page scroll here), split
               evenly between the two previews. Each preview clips rather than scrolling internally —
               click anywhere on one to open it full-size in a dedicated dialog. -->
          <Grid Grid.Column="0" Margin="50,40,50,40">
            <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="News" Margin="0,0,0,16"/>

            <!-- Heading and hint share the same top/bottom margin and VerticalAlignment="Bottom", so
                 their baselines line up off the row's actual height rather than a hand-tuned offset
                 that would drift if either style's font size ever changes. -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Heading3Text}" Text="Readme" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MicroText}" TextWrapping="Wrap" Text="Click to expand" TextAlignment="Right" Margin="0,0,5,6" VerticalAlignment="Bottom"/>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6"
                  Padding="12" Cursor="Hand" Tag="Readme" MouseLeftButtonUp="OnExpandMarkdown">
                  <markdig:MarkdownViewer x:Name="ReadmeViewer" Style="{StaticResource CompactMarkdownViewer}"
                                IsHitTestVisible="False"/>
                </Border>

                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Heading3Text}" Text="Changelog" Margin="0,20,0,6" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MicroText}" TextWrapping="Wrap" Text="Click to expand" TextAlignment="Right" Margin="0,20,5,6" VerticalAlignment="Bottom"/>
                <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6"
                    Padding="12" Cursor="Hand" Tag="Changelog" MouseLeftButtonUp="OnExpandMarkdown">
              <markdig:MarkdownViewer x:Name="ChangelogViewer" Style="{StaticResource CompactMarkdownViewer}"
                                       IsHitTestVisible="False"/>
            </Border>
          </Grid>

          <!-- Divider between the "How to use" and "Profile list" panels. -->
          <Border Grid.Column="1" Width="1" Background="#3A3A42" Margin="0,4"/>

          <!-- Middle: Profile list. Each profile is a tracked WoW directory (LauncherSettings.
               ManagedDirectories) with its own name/realmlist/client identifier/login delay/WDB toggle
               (DirectorySettings) - clicking a row switches to it (same mechanism the old
               DirectorySwitchBox used); its fields are then edited directly in the "Profile settings"
               column to the right, no separate dialog. -->
          <Grid Grid.Column="2" Margin="50,40,50,40">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Heading + an icon-only "Add" button share the title row, matching the DLL/MPQ
                 Patches/Addons tabs' own toolbar convention (icon button, colored via
                 AddActionBrush, tooltip carries the label) instead of a plain text button. -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Heading2Text}" Text="Profiles" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="AddProfileButton" Style="{StaticResource IconButtonStyle}"
                      Content="&#xE710;" Background="{StaticResource AddActionBrush}"
                      Click="OnAddProfile" VerticalAlignment="Center" ToolTip="Add a new profile"/>
            </Grid>

            <!-- Solid card container (matches the Readme/Changelog box styling below) so rows read
                 clearly against the faint background art instead of floating transparently over it. -->
            <Border Grid.Row="1" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1"
                    CornerRadius="6" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProfileListPanel"/>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- Divider between "Profile list" and "Profile settings". -->
          <Border Grid.Column="3" Width="1" Background="#3A3A42" Margin="0,4"/>

          <!-- Right: Profile settings for whichever profile is currently selected, plus Login. Heading
               stays fixed in its own Auto row (same Margin as the other two columns' Grids), and only
               the field content below it scrolls - so all three column titles line up on the same row
               regardless of how much the selected profile's content overflows. -->
          <Grid Grid.Column="4" Margin="50,40,50,40">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="Profile settings" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ProfileSettingsPanel" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Heading3Text}" Text="Name" Margin="0,0,0,6"/>
                    <TextBox x:Name="ProfileNameBox" Height="36" Margin="0,0,0,4"/>
                    <!--<TextBlock Style="{StaticResource MicroText}" Margin="0,0,0,0" TextWrapping="Wrap" Text="Optional. Falls back to the directory path below (or &quot;Default&quot; for the launcher's own folder) when left blank."/>-->
                    <TextBlock Style="{StaticResource Heading2Text}" Text="Login" Margin="0,20,0,20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Style="{StaticResource Heading3Text}" VerticalAlignment="Center" Text="Realmlist" Margin="0,0,0,0"/>
                      <Border Grid.Column="3" Width="1" Background="#3A3A42" Margin="15,0,15,0"/>
                      <!-- <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="Status:" Margin="0,0,6,0"/> -->
                      <!-- Realm status dot: periodically TCP-probed against the realmlist host's auth port
       (see RealmStatusChecker) — green when it accepts a connection, red when it
       doesn't, gray while no realmlist is set or the first check hasn't landed yet. -->
                      <Ellipse x:Name="RealmlistStatusDot" Width="15" Height="15" Fill="#6A6A72" VerticalAlignment="Center" ToolTip="Realm status unknown" />
                    </StackPanel>
                    <ComboBox x:Name="RealmlistBox" Height="36" IsEditable="True" IsTextSearchEnabled="False" SelectionChanged="OnRealmlistHistorySelected"/>
                    <TextBlock Style="{StaticResource Heading3Text}" Text="Account" Margin="0,12,0,6"/>
                    <TextBox x:Name="AccountBox" Height="36"/>
                    <TextBlock Style="{StaticResource Heading3Text}" Text="Password" Margin="0,12,0,6"/>
                  <PasswordBox x:Name="PasswordBoxInput" Height="36"/>
                  <CheckBox x:Name="SavePasswordCheck" Content="Remember password (encrypted on this PC)" Margin="0,10,0,4"/>
                  <CheckBox x:Name="AutoLoginCheck" Content="Enable auto-login" Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource Heading2Text}" Text="Advanced" Margin="0,20,0,20"/>
                    <TextBlock Style="{StaticResource Heading3Text}" Text="Directory" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;"
                          Height="32" Width="32" Margin="8,0,0,0" Click="OnBrowseGameFolder" ToolTip="Browse for the game folder"/>
                  <TextBox x:Name="GameFolderBox" Height="36"/>
                </DockPanel>
                <TextBlock x:Name="GameFolderHint" Style="{StaticResource MicroText}" Margin="0" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Heading3Text}" Text="Client identifier" Margin="0,16,0,6"/>
                <ComboBox x:Name="ClientIdentifierCombo" Height="36" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                          SelectionChanged="OnClientIdentifierSelected"/>
                <TextBlock x:Name="ClientIdentifierWarningText" Style="{StaticResource MicroText}"
                           Foreground="#E6C067" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Pick a client identifier before installing — Play stays disabled until one is set."
                           Visibility="Collapsed"/>
                <TextBlock Style="{StaticResource MicroText}" Margin="0" TextWrapping="Wrap"
                           Text="Determines the download URL and which executable tweaks are offered. Manage the list itself under Settings → Client Identifiers."/>

                <TextBlock Style="{StaticResource Heading3Text}" Text="Login delay (ms)" Margin="0,16,0,6"/>
                <TextBox x:Name="DelayBox" Height="36" Width="130" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource MicroText}" Margin="0" TextWrapping="Wrap"
                           Text="Fallback only! The launcher normally detects when the client has finished loading on its own and logs in immediately."/>

                <CheckBox x:Name="CleanWdbCheck" Content="Clean up client cache (WDB) before every launch" Margin="0,16,0,20"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 1: Tweaks (executable patches) -->
      <TabItem d:IsHidden="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource PageCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading2Text}"
                                     Text="Game Client Tweaks"
                                     Margin="0,0,0,4"
                                     TextAlignment="Center"/>
              <TextBlock Style="{StaticResource MicroText}"
                                     Text="Toggling or adjusting any tweak rebuilds WoW.exe from an untouched backup."
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,4"
                                     TextAlignment="Center"/>
                  <TextBlock Style="{StaticResource MicroText}"
                      Text="Tweaks are applied in a predefined fixed order to ensure the game client does not break or get corrupted."
                      TextWrapping="Wrap"
                      Margin="0,0,0,20"
                      TextAlignment="Center"/>

                  <!-- ============ Mandatory for custom MPQ patches ============ -->
              <TextBlock Style="{StaticResource Heading3Text}"
                                     Text="Mandatory tweaks" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons"
                           FontSize="12" Foreground="#F0C878" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap"
                                     Text="If you plan to use custom MPQ patches, enable everything in this section — it's what keeps a heavier patch set from crashing or refusing to launch."/>
              </DockPanel>

              <!-- Shown only while Signature Removal is off AND one or more custom MPQ patches are
                   still active — that combination isn't a degraded experience, it's an unplayable one:
                   WoW's own file-signature check (left intact without this patch) rejects the unsigned
                   MPQ content and refuses to launch, reporting a corrupted Data folder. Signature
                   Removal is the only one of the three mandatory items that's a hard launch-blocker,
                   which is why it's the only one with a dynamic warning banner - LAA and Config.WTF are
                   "enable to be safe" rather than "enable or it won't start at all". -->
              <Border x:Name="SignatureMpqWarningBanner" Visibility="Collapsed"
                      Background="#3A2A10" BorderBrush="#E0A030" BorderThickness="1" CornerRadius="4"
                      Padding="10,8" Margin="0,0,0,10">
                <TextBlock x:Name="SignatureMpqWarningText" Foreground="#F0C878" FontSize="12" TextWrapping="Wrap"/>
              </Border>

              <StackPanel x:Name="MandatoryPatchesPanel"/>

              <!-- Distinct from the byte-patch list above - this edits specific WTF\Config.WTF
                   keys (a text file), not WoW.exe. -->
              <CheckBox x:Name="ConfigWtfCheck" Content="Force required Config.WTF settings for HD/visual patches"/>
              <TextBlock Foreground="#8A8A92" FontSize="12" TextWrapping="Wrap" Margin="24,2,0,4"
                                     Text="Some HD/visual MPQ patches (e.g. Project Reforged Kronos) require specific Config.WTF settings to render. This only edits those specific keys — your other video settings are left exactly as they are."/>

              <!-- ============ Optional tweaks ============ -->
              <TextBlock Style="{StaticResource Heading3Text}"
                                     Text="Optional tweaks" Margin="0,20,0,4"/>
              <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                     Text="Quality-of-life and visual tweaks. Not required for custom MPQ patches to work, with or without them."/>

              <StackPanel x:Name="PatchesPanel"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- 2: DLLs -->
      <TabItem d:IsHidden="True">
        <!-- Column 1 is what actually keeps the header and list cards aligned: it's reserved for the
             standalone scrollbar in Row 1, and since a Grid's columns are shared by every row in that
             same Grid, Row 0's own (empty) Column 1 cell is automatically forced to that exact same
             width — no guessed pixel constant, so it can't drift no matter how wide the real scrollbar
             renders. Both cards live in Column 0 only, so they always share one identical width. Same
             layout shape as MPQ Patches/Addons — see their own comments for the full rationale. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Pinned top of the card: title, microtext, toolbar + search. Never scrolls. -->
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PageCardTopStyle}">
            <StackPanel>
                  <TextBlock Style="{StaticResource Heading2Text}" Text="DLL Manager" TextAlignment="Center" Margin="0,0,0,20"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnAddDll"
                          Background="{StaticResource AddActionBrush}" ToolTip="Add a DLL to inject"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshDlls" Margin="8,0,0,0"
                          ToolTip="Rescan the game folder for DLLs"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70E;" Click="OnMoveDllUp" Margin="8,0,0,0"
                          ToolTip="Move up in load order (tracked DLLs only)"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70D;" Click="OnMoveDllDown" Margin="8,0,0,0"
                          ToolTip="Move down in load order (tracked DLLs only)"/>
                </StackPanel>

                <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                  <TextBox x:Name="DllSearchBox" Padding="5,4,24,4" TextChanged="OnDllSearchTextChanged"
                           PreviewKeyDown="OnDllSearchKeyDown" GotFocus="OnDllSearchFocusChanged"
                           LostFocus="OnDllSearchFocusChanged" ToolTip="Search DLLs by name"/>
                  <TextBlock x:Name="DllSearchPlaceholder" Style="{StaticResource MicroText}"
                             Text="Search DLLs" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"/>
                  <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#E5484D"
                          Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow"
                          Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,3,0" Click="OnClearDllSearch" ToolTip="Clear search">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ElementName=DllSearchBox, Path=Text.Length}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Bottom of the card: both lists, one shared scroll region — see MpqScrollViewer's own
               comment for the hidden-inner/standalone-outer scrollbar rationale. -->
          <ScrollViewer x:Name="DllScrollViewer" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden">
            <Border Style="{StaticResource PageCardBottomStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource Heading3Text}" Text="Tracked DLLs"/>
                    <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,8"
                         Text="Tracked DLLs are injected on launch, in the order listed. Load order: top → bottom."/>
                    <ListBox x:Name="DllList" HorizontalContentAlignment="Stretch" Margin="0,4,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="OnDllListPreviewMouseWheel" ItemTemplate="{StaticResource DllRowTemplate}"/>

                <TextBlock Style="{StaticResource Heading3Text}" Text="Detected in game folder (not tracked)" Margin="0,20,0,0"/>
                    <TextBlock Style="{StaticResource MicroText}" Text="All DLLs found sitting in the game folder show up below as detected, but are not tracked unless explicitly toggled." TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,8"/>
                    <ListBox x:Name="DetectedDllList" HorizontalContentAlignment="Stretch" Margin="0,4,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="OnDllListPreviewMouseWheel" ItemTemplate="{StaticResource DllRowTemplate}"/>
              </StackPanel>
            </Border>
          </ScrollViewer>
          <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,24"
                     Value="{Binding ElementName=DllScrollViewer, Path=VerticalOffset, Mode=OneWay}"
                     Maximum="{Binding ElementName=DllScrollViewer, Path=ScrollableHeight}"
                     ViewportSize="{Binding ElementName=DllScrollViewer, Path=ViewportHeight}"
                     LargeChange="{Binding ElementName=DllScrollViewer, Path=ViewportHeight}"
                     Visibility="{Binding ElementName=DllScrollViewer, Path=ScrollableHeight, Converter={StaticResource ScrollableToVis}}"
                     Scroll="OnDllScrollBarScroll"/>
        </Grid>
      </TabItem>

      <!-- 3: MPQ Patches -->
      <TabItem d:IsHidden="True">
        <!-- Column 1 is what actually keeps the header and list cards aligned: it's reserved for the
             standalone scrollbar in Row 1, and since a Grid's columns are shared by every row in that
             same Grid, Row 0's own (empty) Column 1 cell is automatically forced to that exact same
             width — no guessed pixel constant, so it can't drift no matter how wide the real scrollbar
             renders. Both cards live in Column 0 only, so they always share one identical width. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Pinned top of the card: title, microtext, buttons. Never scrolls. -->
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PageCardTopStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading2Text}" Text="Custom MPQ Patches" TextAlignment="Center" Margin="0,0,0,20"/>
                  <TextBlock Style="{StaticResource Heading3Text}" Text="Tracked MPQ patches"/>
                  <TextBlock Style="{StaticResource MicroText}" Margin="0,0,0,8"
                         Text="The MPQ patches are stored in .\Data\(patch-A.mpq … patch-Z.mpq). Uncheck to disable (renames to _patch-X.mpq).
                             Base Blizzard patches are not shown!"
                         TextWrapping="Wrap"
                             />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnAddMpq"
                          Background="{StaticResource AddActionBrush}" ToolTip="Add a custom MPQ patch"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshMpq" Margin="8,0,0,0"
                          ToolTip="Rescan Data\ for custom MPQ patches"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE73A;" Click="OnSelectAllMpq" Margin="8,0,0,0"
                          ToolTip="Enable all patches"/>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" Click="OnDeselectAllMpq" Margin="8,0,0,0"
                          ToolTip="Disable all patches"/>
                </StackPanel>

                <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                  <TextBox x:Name="MpqSearchBox" Padding="5,4,24,4" TextChanged="OnMpqSearchTextChanged"
                           PreviewKeyDown="OnMpqSearchKeyDown" GotFocus="OnMpqSearchFocusChanged"
                           LostFocus="OnMpqSearchFocusChanged" ToolTip="Search patches by name"/>
                  <TextBlock x:Name="MpqSearchPlaceholder" Style="{StaticResource MicroText}"
                             Text="Search Patches" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"/>
                  <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#E5484D"
                          Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow"
                          Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,3,0" Click="OnClearMpqSearch" ToolTip="Clear search">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ElementName=MpqSearchBox, Path=Text.Length}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Grid>

              <!-- Mirrors SignatureMpqWarningBanner on the Tweaks tab — shown whenever Signature
                   Removal is off while a patch below is still active, so the warning reaches the user
                   regardless of which of the two tabs they happen to be looking at. -->
              <Border x:Name="MpqSignatureWarningBanner" Visibility="Collapsed"
                      Background="#3A2A10" BorderBrush="#E0A030" BorderThickness="1" CornerRadius="4"
                      Padding="10,8" Margin="0,8,0,0">
                <TextBlock x:Name="MpqSignatureWarningText" Foreground="#F0C878" FontSize="12" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Bottom of the card: the patch list. This ScrollViewer's own scrollbar is hidden (it still
               scrolls via mouse wheel/keyboard, just doesn't draw its own UI) and it spans Column 0
               edge to edge, so the wheel scrolls the list from anywhere over that whole region — a real
               page-wide scroll area, not one scoped to hovering over the narrower card. The visible
               scrollbar is the standalone ScrollBar in Column 1 below, bound to this ScrollViewer.
               PageCardBottomStyle's Border is Auto-height/top-aligned, so a short list produces a short
               card (no forced fill-to-bottom dead space); a long list grows past the row's available
               height and scrolling kicks in, header unmoved. -->
          <ScrollViewer x:Name="MpqScrollViewer" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden">
            <Border Style="{StaticResource PageCardBottomStyle}">
              <StackPanel x:Name="MpqPanel"/>
            </Border>
          </ScrollViewer>
          <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,24"
                     Value="{Binding ElementName=MpqScrollViewer, Path=VerticalOffset, Mode=OneWay}"
                     Maximum="{Binding ElementName=MpqScrollViewer, Path=ScrollableHeight}"
                     ViewportSize="{Binding ElementName=MpqScrollViewer, Path=ViewportHeight}"
                     LargeChange="{Binding ElementName=MpqScrollViewer, Path=ViewportHeight}"
                     Visibility="{Binding ElementName=MpqScrollViewer, Path=ScrollableHeight, Converter={StaticResource ScrollableToVis}}"
                     Scroll="OnMpqScrollBarScroll"/>
        </Grid>
      </TabItem>

      <!-- 4: Addons -->
      <TabItem d:IsHidden="True">
        <!-- Column 1 is what actually keeps the header and list cards aligned: it's reserved for the
             standalone scrollbar in Row 1, and since a Grid's columns are shared by every row in that
             same Grid, Row 0's own (empty) Column 1 cell is automatically forced to that exact same
             width — no guessed pixel constant, so it can't drift no matter how wide the real scrollbar
             renders. Both cards live in Column 0 only, so they always share one identical width. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Pinned top of the card: title, microtext, Installed/Browse toggle, then whichever
               header row matches the selected sub-tab. Never scrolls. -->
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PageCardTopStyle}">
            <StackPanel>
                  <TextBlock Style="{StaticResource Heading2Text}" Text="Addons Manager" TextAlignment="Center"/>

                  <!-- Installed/Browse sub-tab toggle - same RadioButton+underline look as the top-level
                   nav (NavButtonStyle), scoped to its own GroupName so it doesn't interact with the
                   real page navigation, and sized down to read as a sub-toggle, not a second nav bar. -->
              <StackPanel Orientation="Horizontal" Margin="0,10,0,10" HorizontalAlignment="Center">
                <RadioButton x:Name="AddonsInstalledToggle" GroupName="AddonsSubTab" IsChecked="True"
                             Style="{StaticResource NavButtonStyle}" FontSize="15" Content="Installed"
                             Margin="0" Checked="OnAddonsSubTabChanged"/>
                <RadioButton x:Name="AddonsBrowseToggle" GroupName="AddonsSubTab"
                             Style="{StaticResource NavButtonStyle}" FontSize="15" Content="Browse"
                             Checked="OnAddonsSubTabChanged"/>
              </StackPanel>

              <!-- Installed sub-tab header: Add/Refresh/Update All/search (unchanged from before). -->
              <Grid x:Name="InstalledHeaderRow"
                    Visibility="{Binding IsChecked, ElementName=AddonsInstalledToggle, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource MicroText}"
                        Margin="0,0,0,4"
                        Text="Add by GitHub/GitLab repo URL, a Legacy-WoW or Warperia addon page URL, a direct archive URL, or a local .zip/.rar/.7z file.
                               Addons are installed into .\Interface\AddOns\(AddonFolder)."
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        TextAlignment="Center"
                    />
                    <TextBlock Style="{StaticResource MicroText}"
                        Margin="0,0,0,20"
                        Text="Addons are installed into .\Interface\AddOns\(AddonFolder)."
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        TextAlignment="Center"
                    />
                    <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                      <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnOpenAddAddonDialog"
                        Background="{StaticResource AddActionBrush}" ToolTip="Add an addon"/>
                    <Button x:Name="UpdateAllAddonsButton" Content="&#xE896;"
                        Click="OnUpdateAllAddonsClick" Margin="8,0,0,0" IsEnabled="False"
                        ToolTip="Update every addon with an available update">
                    <Button.Style>
                      <!-- Gold (UpdateActionBrush) only applies via this IsEnabled trigger, not a
                           local Background value — a local value would outrank the base style's own
                           disabled-state handling, so the accent would stay fully saturated even
                           while disabled. -->
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
                        <Style.Triggers>
                          <Trigger Property="IsEnabled" Value="True">
                            <Setter Property="Background" Value="{StaticResource UpdateActionBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshAddons" Margin="8,0,0,0"
        ToolTip="Refresh: reload, adopt local addons, and check for updates"/>
                </StackPanel>
                <Grid Grid.Column="1" Grid.Row="3" Width="260" VerticalAlignment="Center">
                  <TextBox x:Name="AddonSearchBox" Padding="5,4,24,4" TextChanged="OnAddonSearchTextChanged"
                           PreviewKeyDown="OnAddonSearchKeyDown" GotFocus="OnAddonSearchFocusChanged"
                           LostFocus="OnAddonSearchFocusChanged" ToolTip="Search addons by name"/>
                  <TextBlock x:Name="AddonSearchPlaceholder" Style="{StaticResource MicroText}"
                             Text="Search Addons" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"/>
                  <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#E5484D"
                          Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow"
                          Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,3,0" Click="OnClearAddonSearch" ToolTip="Clear search">
                    <Button.Style>
                      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ElementName=AddonSearchBox, Path=Text.Length}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Grid>

              <!-- Browse sub-tab header: Provider/Category/Sort + search (same look as the Installed
                   search box) + Refresh, all icon-driven to match the rest of the launcher. -->
              <Grid x:Name="BrowseHeaderRow"
                    Visibility="{Binding IsChecked, ElementName=AddonsBrowseToggle, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;"
        Click="OnMarketplaceRefreshClick" ToolTip="Refresh catalog" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MarketplaceProviderCombo" Grid.Column="1" Width="120" Margin="0,0,8,0"
                          SelectionChanged="OnMarketplaceProviderChanged" ToolTip="Addon source"/>
                <ComboBox x:Name="MarketplaceCategoryCombo" Grid.Column="2" Width="150" Margin="0,0,8,0"
                          SelectionChanged="OnMarketplaceCategoryChanged" ToolTip="Category"/>
                <ComboBox x:Name="MarketplaceSortCombo" Grid.Column="3" Width="130" Margin="0,0,8,0"
                          SelectionChanged="OnMarketplaceSortChanged" ToolTip="Sort by"/>
                <!-- Column 4 (the empty "*" spacer) absorbs whatever space is left, so the search
                     box and Refresh button below - each in their own reserved Auto column - always
                     get their full declared width instead of being squeezed and clipped, matching
                     how InstalledHeaderRow reserves Column1 for its own search Grid. Refresh sits
                     after Search so it lands at the far right edge of the header row. -->
                    <Grid Grid.Column="5" Width="190" Margin="0,0,0,0" VerticalAlignment="Center">
                      <TextBox x:Name="MarketplaceSearchBox" Padding="5,4,24,4" TextChanged="OnMarketplaceFilterChanged"
                           PreviewKeyDown="OnMarketplaceSearchKeyDown" GotFocus="OnMarketplaceSearchFocusChanged"
                           LostFocus="OnMarketplaceSearchFocusChanged" ToolTip="Search this catalog by name"/>
                      <TextBlock x:Name="MarketplaceSearchPlaceholder" Style="{StaticResource MicroText}"
                             Text="Search Addons" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"/>
                      <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#E5484D"
                          Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow"
                          Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,3,0" Click="OnClearMarketplaceSearch" ToolTip="Clear search">
                        <Button.Style>
                          <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ElementName=MarketplaceSearchBox, Path=Text.Length}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </Grid>
                  </Grid>
            </StackPanel>
          </Border>

          <!-- Bottom of the card: the addon list. This ScrollViewer's own scrollbar is hidden (it still
               scrolls via mouse wheel/keyboard, just doesn't draw its own UI) and it spans Column 0
               edge to edge, so the wheel scrolls the list from anywhere over that whole region — a real
               page-wide scroll area, not one scoped to hovering over the narrower card. The visible
               scrollbar is the standalone ScrollBar in Column 1 below, bound to this ScrollViewer.
               PageCardBottomStyle's Border is Auto-height/top-aligned, so a short list produces a short
               card (no forced fill-to-bottom dead space); a long list grows past the row's available
               height and scrolling kicks in, header unmoved. AddonList's own internal scrollbar is
               explicitly disabled so it never fights with this one; with nothing constraining its
               height it simply lays out every row at full size instead. -->
          <ScrollViewer x:Name="AddonScrollViewer" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden"
                        Visibility="{Binding IsChecked, ElementName=AddonsInstalledToggle, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource PageCardBottomStyle}">
              <ListBox x:Name="AddonList" HorizontalContentAlignment="Stretch"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       PreviewMouseWheel="OnAddonListPreviewMouseWheel">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <Button Grid.Column="0" Style="{StaticResource GhostIconButtonStyle}" Content="&#xE946;"
                              Tag="{Binding}" Click="OnAddonDetailsClick" ToolTip="View details"
                              Margin="0,0,8,0"/>

                      <Button Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}" Content="&#xE8AC;"
                              Tag="{Binding}" Click="OnRenameAddonFolderClick" ToolTip="Rename this addon's folder"
                              Margin="0,0,8,0"/>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyText}" svc:WowColoredText.Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionDisplay}" Style="{StaticResource CaptionText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SourceLabel, StringFormat='• {0}'}" Style="{StaticResource CaptionText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>

                      <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE896;"
                              Tag="{Binding}" Click="OnUpdateAddonClick" ToolTip="Update this addon"
                              Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                              Margin="8,0,0,0" Width="28" Height="28" Background="{StaticResource UpdateActionBrush}"/>
                      <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                              Tag="{Binding}" Click="OnRemoveAddonClick" ToolTip="Remove this addon"
                              Margin="8,0,0,0" Width="28" Height="28" Background="{StaticResource RemoveActionBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </ScrollViewer>
          <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,24"
                     Value="{Binding ElementName=AddonScrollViewer, Path=VerticalOffset, Mode=OneWay}"
                     Maximum="{Binding ElementName=AddonScrollViewer, Path=ScrollableHeight}"
                     ViewportSize="{Binding ElementName=AddonScrollViewer, Path=ViewportHeight}"
                     LargeChange="{Binding ElementName=AddonScrollViewer, Path=ViewportHeight}"
                     Scroll="OnAddonScrollBarScroll">
            <!-- MultiBinding (not just ScrollableToVis on ScrollableHeight alone) because this
                 ScrollBar shares its Grid cell with MarketplaceScrollBar (Browse sub-tab) - gating
                 on scrollable content alone left it visible even while Browse was the active
                 sub-tab, since switching sub-tabs never changes AddonScrollViewer's own content. -->
            <ScrollBar.Visibility>
              <MultiBinding Converter="{StaticResource TabScrollBarVis}">
                <Binding ElementName="AddonsInstalledToggle" Path="IsChecked"/>
                <Binding ElementName="AddonScrollViewer" Path="ScrollableHeight"/>
              </MultiBinding>
            </ScrollBar.Visibility>
          </ScrollBar>

          <!-- Browse sub-tab body: still a genuinely height-constrained, natively-scrolling ListBox
               (default VirtualizingStackPanel applies, via ScrollViewer.CanContentScroll="True") -
               that part deliberately isn't the outer-ScrollViewer/standalone-ScrollBar trick used
               below for the Installed list, since that pattern realizes every row regardless of
               scroll position and won't scale to Legacy-WoW's ~700-entry catalog. But its own
               internal scrollbar visually broke PageCardBottomStyle's rounded corner (same issue
               the Installed list had before it got its own hidden-internal/standalone-external
               split) - fixed the same way: the internal scrollbar chrome is hidden
               (ScrollViewer.VerticalScrollBarVisibility="Hidden", which only hides the chrome, it
               doesn't stop the ListBox from scrolling itself the way "Disabled" would) and a
               standalone ScrollBar in Column 1 mirrors it, kept in sync via the ScrollChanged event
               in code-behind since the ListBox's real internal ScrollViewer lives inside its
               default template and isn't a named, bindable element the way AddonScrollViewer is. -->
          <!-- Wrapping Grid (rather than putting Row/Column directly on the Border) exists so this
               element - like AddonScrollViewer next to it - Stretches to fill the whole Row1/Column0
               cell, not just PageCardBottomStyle's own Auto-height/top-aligned card. That's what lets
               the mouse wheel scroll the list from anywhere in the tab's body (including the empty
               background below a short/loading list), not only while hovering the ListBox itself;
               PreviewMouseWheel here reaches MarketplaceList's internal ScrollViewer directly (same
               "intercept before the nested ScrollViewer eats it" reasoning as
               OnAddonListPreviewMouseWheel, just targeting the ListBox's own inner ScrollViewer
               instead of an outer wrapper one, since this list needs to keep its real internal
               scrolling for virtualization). -->
          <Grid Grid.Row="1" Grid.Column="0" Background="Transparent"
                Visibility="{Binding IsChecked, ElementName=AddonsBrowseToggle, Converter={StaticResource BoolToVis}}"
                PreviewMouseWheel="OnMarketplacePreviewMouseWheel">
            <Border Style="{StaticResource PageCardBottomStyle}">
              <DockPanel>
                <ListBox x:Name="MarketplaceList" Style="{StaticResource MarketplaceListStyle}"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.ScrollChanged="OnMarketplaceListScrollChanged">
                  <ListBox.ItemTemplate>
                  <DataTemplate>
                    <!-- Loaded fires when the virtualizing panel actually realizes this row's
                         container (and again if it's recycled back into view later) - that's what
                         drives lazy, only-when-visible thumbnail loading (see
                         OnMarketplaceRowLoaded), instead of firing a fetch for every entry in the
                         whole filtered list up front. -->
                    <Grid Margin="0,6" Loaded="OnMarketplaceRowLoaded">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <Button Grid.Column="0" Style="{StaticResource GhostIconButtonStyle}" Content="&#xE946;"
                              Tag="{Binding}" Click="OnMarketplaceDetailsClick" ToolTip="View details"
                              Margin="0,0,8,0"/>

                      <Border Grid.Column="1" Width="44" Height="44" Margin="0,0,10,0" Background="#26262B"
                              CornerRadius="4" ClipToBounds="True">
                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                      </Border>

                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Style="{StaticResource BodyText}" Text="{Binding Entry.Name}"/>
                          <TextBlock Text="{Binding AuthorDisplay}" Style="{StaticResource CaptionText}"
                                     Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Entry.Description}" Style="{StaticResource MicroText}"
                                   TextWrapping="Wrap" MaxWidth="520" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>

                      <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                              Content="{Binding InstallGlyph}" Tag="{Binding}" Click="OnMarketplaceInstallClick"
                              ToolTip="{Binding InstallToolTip}" Margin="8,0,0,0"
                              Background="{Binding InstallBackground}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          </Grid>
          <ScrollBar x:Name="MarketplaceScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,24"
                     Scroll="OnMarketplaceScrollBarScroll">
            <ScrollBar.Visibility>
              <MultiBinding Converter="{StaticResource TabScrollBarVis}">
                <Binding ElementName="AddonsBrowseToggle" Path="IsChecked"/>
                <Binding ElementName="MarketplaceScrollBar" Path="Maximum"/>
              </MultiBinding>
            </ScrollBar.Visibility>
          </ScrollBar>
        </Grid>
      </TabItem>

      <!-- 5: Settings -->
      <TabItem d:IsHidden="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{StaticResource PageCardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading2Text}" Text="Settings" TextAlignment="Center" Margin="0,0,0,4"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Settings that are global for the whole launcher are marked with:" Style="{StaticResource MicroText}"/>
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Foreground="{StaticResource InstallActionBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Text="." Style="{StaticResource MicroText}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource MicroText}"
                      Text="Settings not marked as global apply only to the currently selected client directory."
                      TextAlignment="Center"
                      Margin="0,0,0,20"
                      TextWrapping="Wrap"
                  />
              <TextBlock Style="{StaticResource Heading3Text}" Text="Game files"/>
              <TextBlock Style="{StaticResource MicroText}" Margin="0,0,0,4" TextWrapping="Wrap"
                         Text="Applies to whichever profile is currently selected on Home."/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                <Button x:Name="RepairGameFilesButton" Content="Repair Game Files" Click="OnRepairGameFiles"/>
                <Button x:Name="DeleteGameFilesButton" Content="Delete Game Files" Click="OnDeleteGameFiles" Margin="8,0,0,0"
                        Background="{StaticResource RemoveActionBrush}"/>
              </StackPanel>
              <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap" Margin="0,0,0,20"
                                     Text="Repair re-downloads and reinstalls the full client from the source URL below, overwriting any file that differs (no per-file update list, so this always refreshes the whole install). Delete removes exactly what the client archive provided (Data\, WoW.exe, Fonts\, etc.) - your installed addons, WTF settings, and logs are left untouched."/>

              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE774;" FontFamily="Segoe Fluent Icons"
                           FontSize="14" Foreground="{StaticResource InstallActionBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Global setting"/>
                <TextBlock Style="{StaticResource Heading3Text}" Text="Client Identifiers"/>
              </DockPanel>
              <TextBlock Style="{StaticResource MicroText}" Margin="0,0,0,8" TextWrapping="Wrap"
                         Text="Known servers/clients, shared across every profile. Each profile picks one by name in its Profile settings panel on Home; editing a client identifier's URL or category here applies to every profile using it."/>
              <StackPanel x:Name="ClientProfilesPanel" Margin="0,0,0,8"/>
              <Button x:Name="AddClientProfileButton" Content="Add Client Identifier" HorizontalAlignment="Left"
                      Click="OnAddClientProfile" Margin="0,0,0,20"/>

              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE774;" FontFamily="Segoe Fluent Icons"
                           FontSize="14" Foreground="{StaticResource InstallActionBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Global setting"/>
                <TextBlock Style="{StaticResource Heading3Text}" Text="Launcher window"/>
              </DockPanel>
              <CheckBox x:Name="MinimizeOnLaunchCheck" Content="Minimize the launcher when the game starts" Margin="0,4,0,4"/>
              <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap" Margin="0,0,0,20"
                         Text="The launcher automatically comes back to the foreground once the game closes, whether or not this is enabled."/>

              <TextBlock Style="{StaticResource Heading3Text}" Text="Ignored DLLs"/>
              <TextBlock Style="{StaticResource MicroText}"
                         Text="DLLs hidden from the DLLs tab's &quot;Detected in game folder&quot; list (e.g. files that aren't actually meant for injection). Un-ignore to make them detectable again."
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ListBox x:Name="IgnoredDllList" Height="100" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Un-ignore Selected" Click="OnUnignoreDlls"/>
                <Button Content="Un-ignore All" Click="OnUnignoreAllDlls" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- 6: Log -->
      <TabItem>
        <!-- Full-width like DLLs (log lines/stack traces need real width) but structured like MPQ
             Patches/Addons: a pinned header above a separately-scrollable list, sharing Column 0's
             width between both rows so the two card halves' edges always line up, with a standalone
             ScrollBar in Column 1 instead of LogList's own (kept hidden — see
             OnLogListPreviewMouseWheel below for why that's necessary). -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Pinned top of the card: title, description, actions. Never scrolls. -->
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WideCardTopStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading2Text}" Text="Application Log" TextAlignment="Center"/>
              <TextBlock Style="{StaticResource MicroText}" Margin="0,4,0,20"
                         Text="Logs live events as the launcher runs. The 'Clear' button only clears this view, but retains the file under Logs\ in the application's AppData settings folder"
                         TextAlignment="Center"
                         />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Click="OnClearLog"
                        ToolTip="Clear this view (does not delete the log file)"/>
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8C8;" Click="OnCopyLog" Margin="8,0,0,0"
                        ToolTip="Copy the visible log to the clipboard"/>
                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE838;" Click="OnOpenLogFolder" Margin="8,0,0,0"
                        ToolTip="Open the log file's folder"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Bottom of the card: the log list. Same hidden-inner-scrollbar / standalone-outer-
               ScrollBar pattern as MPQ Patches/Addons — see their own comments for the full rationale. -->
          <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden">
            <Border Style="{StaticResource WideCardBottomStyle}">
              <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemTemplate="{StaticResource LogRowTemplate}"
                       PreviewMouseWheel="OnLogListPreviewMouseWheel"/>
            </Border>
          </ScrollViewer>
          <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,16"
                     Value="{Binding ElementName=LogScrollViewer, Path=VerticalOffset, Mode=OneWay}"
                     Maximum="{Binding ElementName=LogScrollViewer, Path=ScrollableHeight}"
                     ViewportSize="{Binding ElementName=LogScrollViewer, Path=ViewportHeight}"
                     LargeChange="{Binding ElementName=LogScrollViewer, Path=ViewportHeight}"
                     Visibility="{Binding ElementName=LogScrollViewer, Path=ScrollableHeight, Converter={StaticResource ScrollableToVis}}"
                     Scroll="OnLogScrollBarScroll"/>
        </Grid>
      </TabItem>
      </TabControl>

      <!-- Unified toast stack (issue #13): up to 10 cards, pinned top-right - a child of THIS Body grid
           specifically (not the outer window Grid) so "top" resolves to just below the header/nav,
           not the very top of the window behind it. Above every tab's own content regardless of which
           is active. Every ShowToast call site passes its own fixed source label explicitly (never
           derived from whichever tab happens to be selected) - a card's title can't end up wrong just
           because the user switched tabs while an async operation was still in flight, and cards don't
           need to be cleared on tab switch either. Built directly in code-behind (MainWindow.xaml.cs)
           rather than an ItemsControl+DataTemplate, matching this codebase's existing convention for
           repeated small UI (see MpqPanel). -->
      <StackPanel x:Name="ToastHost" VerticalAlignment="Top" HorizontalAlignment="Right"
                  Margin="0,16,24,0" IsHitTestVisible="True"/>
    </Grid>
  </DockPanel>

    <!-- Fog overlay: shown while any of our own dialogs is open (ShowModal below), so the launcher
         behind a modal reads as "in the back" instead of looking identical to when it's active. Purely
         visual — WPF's Window.ShowDialog already disables/redirects focus for the owner on its own.
         Deliberately still a sibling of the whole DockPanel (not nested in the Body grid like
         ToastHost above) so it fogs the header/title bar too, not just the tab content. -->
    <Border x:Name="ModalOverlay" Background="#A6101014" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Window>
