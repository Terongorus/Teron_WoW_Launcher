<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:svc="clr-namespace:TeronWoWLauncher.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" x:Class="TeronWoWLauncher.MainWindow"
        Height="700" Width="980" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1F">

  <shell:WindowChrome.WindowChrome>
    <!--
      Replaces the default Windows title bar/icon/min-max-close with our own row (below), while
      keeping the OS's resize handles, Aero Snap (drag-to-edge, Win+arrow), and drop shadow — those
      come from WindowChrome itself, not from the native caption we're hiding. CaptionHeight must
      match the custom title bar row's own Height so the OS treats exactly that strip as the
      draggable/double-click-to-maximize caption area; the three buttons inside opt back out of that
      via WindowChrome.IsHitTestVisibleInChrome so clicks register as clicks, not drags.
    -->
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                         UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- The app-wide TextBlock/CheckBox/TextBox/PasswordBox/ListBox/Button/window-control-button
         styles (App.xaml) cover this window too — no local overrides here. -->

    <!-- Tab headers are hidden; navigation is driven by the header-bar labels below instead. -->
    <Style x:Key="HeaderlessTabControl" TargetType="{x:Type TabControl}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A nav "tab" rendered as a plain clickable label with a gold underline when active. -->
    <Style x:Key="NavButtonStyle" TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="#9A9AA2"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C067"/>
                <Setter Property="Foreground" Value="#E6C067"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#DADADD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Compact preview mode for the Home tab's Readme/Changelog boxes: no internal scrollbar and no
      zoom toolbar, since overflow is handled by clicking through to the full-size expand dialog
      instead. This replaces the whole control template, so it's scoped to this window only — the
      expand dialog defines its own (normally-scrolling) MarkdownViewer template.
    -->
    <Style x:Key="CompactMarkdownViewer" TargetType="{x:Type markdig:MarkdownViewer}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type markdig:MarkdownViewer}">
            <FlowDocumentScrollViewer Document="{TemplateBinding Document}"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"
                                      IsToolBarVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DllList/DetectedDllList row: name plus whatever version-resource metadata was found for it,
         all on one line — Summary already omits any field that wasn't present on the file itself. -->
    <DataTemplate x:Key="DllRowTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.CommandBindings>
    <CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="OnMarkdownHyperlink"/>
  </Window.CommandBindings>

  <Grid>
  <DockPanel>
    <!-- Header: title + window controls share one row (flush to the top-right corner, no gap
         above it), nav labels centered on the row below. The empty space around the centered
         title in row 0 is still draggable/double-click-to-maximize, since it's within
         WindowChrome's CaptionHeight (kept equal to this row's fixed height) and doesn't opt out
         via IsHitTestVisibleInChrome — only the three buttons do. -->
    <Border DockPanel.Dock="Top" Background="#111114">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <TextBlock x:Name="HeaderText" Style="{StaticResource Heading1Text}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"/>
          <TextBlock x:Name="VersionLabel" Style="{StaticResource MicroText}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xE921;"
                    Click="OnMinimizeClicked" ToolTip="Minimize"/>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowControlButtonStyle}" Content="&#xE922;"
                    Click="OnMaximizeRestoreClicked" ToolTip="Maximize"/>
            <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                    Click="OnCloseClicked" ToolTip="Close"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="NavPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="16,0,16,12">
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="0"
                                 Content="Home" Click="OnNavClicked" IsChecked="True" Margin="0"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="1"
                                 Content="Tweaks" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="2"
                                 Content="DLLs" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="3"
                                 Content="MPQ Patches" Click="OnNavClicked" Checked="RadioButton_Checked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="4"
                                 Content="Addons" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="5"
                                 Content="Settings" Click="OnNavClicked"/>
          <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" Tag="6"
                                 Content="Log" Click="OnNavClicked"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer: status + progress bar, and the Play/Install/Update button -->
    <Border DockPanel.Dock="Bottom" Background="#111114" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
          <ProgressBar x:Name="MainProgressBar" Height="10" Minimum="0" Maximum="100"
                                 Background="#101014" Foreground="#3B7D3B" BorderBrush="#3A3A42"
                                 BorderThickness="1" Visibility="Collapsed"/>
        </StackPanel>

        <Button Grid.Column="1" x:Name="PlayButton" Content="PLAY" Click="OnPlayClicked"
                        Width="170" Height="46" Background="#3B7D3B" Foreground="White" FontSize="18"
                        FontWeight="Bold" BorderThickness="0" Margin="5, 10, 5, 10"/>
      </Grid>
    </Border>

    <!-- Body -->
    <TabControl x:Name="MainTabs" Style="{StaticResource HeaderlessTabControl}"
                    Background="#1B1B1F" BorderThickness="0" Padding="0" SelectedIndex="0">

      <!-- 0: Home (Login & Game) -->
      <TabItem d:IsHidden="True">
        <Grid Margin="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left: How to use. Fills the column's real height (no outer page scroll here), split
               evenly between the two previews. Each preview clips rather than scrolling internally —
               click anywhere on one to open it full-size in a dedicated dialog. -->
          <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Heading2Text}" Text="News" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" Style="{StaticResource Heading3Text}" Text="Readme" Margin="0,0,0,6"/>
            <Border Grid.Row="2" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6"
                    Padding="12" Cursor="Hand" Tag="Readme" MouseLeftButtonUp="OnExpandMarkdown">
              <markdig:MarkdownViewer x:Name="ReadmeViewer" Style="{StaticResource CompactMarkdownViewer}"
                                       IsHitTestVisible="False"/>
            </Border>

            <TextBlock Grid.Row="3" Style="{StaticResource Heading3Text}" Text="Changelog" Margin="0,20,0,6"/>
            <Border Grid.Row="4" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6"
                    Padding="12" Cursor="Hand" Tag="Changelog" MouseLeftButtonUp="OnExpandMarkdown">
              <markdig:MarkdownViewer x:Name="ChangelogViewer" Style="{StaticResource CompactMarkdownViewer}"
                                       IsHitTestVisible="False"/>
            </Border>
          </Grid>

          <!-- Divider between the "How to use" and "Login" panels. -->
          <Border Grid.Column="1" Width="1" Background="#3A3A42" Margin="0,4"/>

          <!-- Right: Login -->
          <Grid Grid.Column="2" Margin="20,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Heading2Text}" Text="Login"/>
              <TextBlock DockPanel.Dock="Right" x:Name="RealmlistLabel" Style="{StaticResource CaptionText}"
                                       Text="Realmlist: (not set)"
                                       VerticalAlignment="Center" Cursor="Hand" TextDecorations="Underline"
                                       MouseLeftButtonUp="OnRealmlistLabelClicked"/>
            </DockPanel>

            <StackPanel Grid.Row="1" MaxWidth="420" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoLoginCheck" Content="Enable auto-login" Margin="0"/>

              <TextBlock Style="{StaticResource BodyText}" Text="Account" Margin="0,16,0,4"/>
              <TextBox x:Name="AccountBox"/>

              <TextBlock Style="{StaticResource BodyText}" Text="Password" Margin="0,12,0,4"/>
              <PasswordBox x:Name="PasswordBoxInput"/>
              <CheckBox x:Name="SavePasswordCheck"
                                      Content="Remember password (encrypted on this PC)"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 1: Tweaks (executable patches) -->
      <TabItem d:IsHidden="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border MaxWidth="620" Margin="24" HorizontalAlignment="Center"
                  Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6" Padding="24">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading3Text}"
                                     Text="Executable tweaks (rebuilt from a pristine backup, in fixed order)"
                                     Margin="0,0,0,4"/>
              <TextBlock Style="{StaticResource MicroText}"
                                     Text="1. Signature Removal → 2. VanillaTweaks. Toggling or adjusting any tweak rebuilds WoW.exe from the untouched backup, as soon as you change it."
                                     TextWrapping="Wrap" Margin="0,0,0,8"/>
              <StackPanel x:Name="PatchesPanel"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- 2: DLLs -->
      <TabItem d:IsHidden="True">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left: tracked DLLs (dlls.txt, load order) -->
          <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource Heading3Text}" Text="DLLs injected on launch (dlls.txt, load order top → bottom)"/>
              <TextBlock Style="{StaticResource MicroText}" Text="Only files that exist are injected."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnAddDll"
                      ToolTip="Add a DLL to inject"/>
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Click="OnRemoveDll" Margin="8,0,0,0"
                      ToolTip="Remove the selected DLL"/>
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70E;" Click="OnMoveDllUp" Margin="8,0,0,0"
                      ToolTip="Move up in load order"/>
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE70D;" Click="OnMoveDllDown" Margin="8,0,0,0"
                      ToolTip="Move down in load order"/>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="DllList" ItemTemplate="{StaticResource DllRowTemplate}"/>
          </Grid>

          <!-- Divider between the tracked and detected DLL lists. -->
          <Border Grid.Column="1" Width="1" Background="#3A3A42" Margin="0,4"/>

          <!-- Right: DLLs detected in the game folder, not yet tracked -->
          <Grid Grid.Column="2" Margin="16,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource Heading3Text}" Text="Detected in game folder (not tracked)"/>
              <TextBlock Style="{StaticResource MicroText}" Text="DLLs found directly in the game folder that aren't in dlls.txt yet."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshDetectedDlls"
                      ToolTip="Rescan the game folder for new DLLs"/>
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnAddDetectedDlls" Margin="8,0,0,0"
                      ToolTip="Start tracking the selected DLL(s)"/>
              <Button Style="{StaticResource IconButtonStyle}" Content="&#xED1A;" Click="OnIgnoreDetectedDlls" Margin="8,0,0,0"
                      ToolTip="Ignore the selected DLL(s) (won't be suggested again)"/>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="DetectedDllList" SelectionMode="Extended" ItemTemplate="{StaticResource DllRowTemplate}"/>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 3: MPQ Patches -->
      <TabItem d:IsHidden="True">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Heading3Text}" Text="Custom MPQ patches in Data\ (patch-A.mpq … patch-Z.mpq)"/>
            <TextBlock Style="{StaticResource MicroText}" Text="Uncheck to disable (renames to _patch-X.mpq). Base Blizzard patches are not shown."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnAddMpq"
                    ToolTip="Add a custom MPQ patch"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshMpq" Margin="8,0,0,0"
                    ToolTip="Rescan Data\ for custom MPQ patches"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE73A;" Click="OnSelectAllMpq" Margin="8,0,0,0"
                    ToolTip="Enable all patches"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" Click="OnDeselectAllMpq" Margin="8,0,0,0"
                    ToolTip="Disable all patches"/>
          </StackPanel>
          <Border Grid.Row="2" Background="#101014" BorderBrush="#3A3A42" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
              <StackPanel x:Name="MpqPanel"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- 4: Addons -->
      <TabItem d:IsHidden="True">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Heading3Text}" Text="Addons (installed into Interface\AddOns)"/>
            <TextBlock Style="{StaticResource MicroText}" Text="Add by GitHub repo URL, a direct archive URL, or a local .zip/.rar/.7z file."/>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="OnOpenAddAddonDialog"
                    ToolTip="Add an addon"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="OnRefreshAddons" Margin="8,0,0,0"
                    ToolTip="Refresh: reload, adopt local addons, and check for updates"/>
            <TextBlock x:Name="AddonStatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>

          <ListBox Grid.Row="2" x:Name="AddonList" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyText}" svc:WowColoredText.Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionDisplay}" Style="{StaticResource CaptionText}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>

                  <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE896;"
                          Tag="{Binding}" Click="OnUpdateAddonClick" ToolTip="Update this addon"
                          Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                          Margin="8,0,0,0" Width="28" Height="28" Background="#2E6DA4"/>
                  <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                          Tag="{Binding}" Click="OnRemoveAddonClick" ToolTip="Remove this addon"
                          Margin="8,0,0,0" Width="28" Height="28"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <!-- 5: Settings -->
      <TabItem d:IsHidden="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border MaxWidth="620" Margin="24" HorizontalAlignment="Center"
                  Background="#101014" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6" Padding="24">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading3Text}" Text="Installation directory"/>
              <TextBlock Style="{StaticResource MicroText}" Text="The folder containing WoW.exe. If you moved your install, browse to the new location."
                                     Margin="0,0,0,4" TextWrapping="Wrap"/>
              <DockPanel Margin="0,4,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;"
                        Margin="8,0,0,0" Click="OnBrowseGameFolder" ToolTip="Browse for the game folder"/>
                <TextBox x:Name="GameFolderBox"/>
              </DockPanel>
              <TextBlock x:Name="GameFolderHint" Style="{StaticResource MicroText}" Margin="0,0,0,16"/>

              <Button Content="Repair Game Files" Click="OnRepairGameFiles"
                                  HorizontalAlignment="Left" Margin="0,0,0,4"/>
              <TextBlock Style="{StaticResource MicroText}" TextWrapping="Wrap" Margin="0,0,0,20"
                                     Text="Re-downloads and reinstalls the full client from the source URL below, overwriting any file that differs. There is no per-file update list for this client, so this always refreshes the whole install."/>

              <TextBlock Style="{StaticResource Heading3Text}" Text="Realmlist"/>
              <TextBlock Style="{StaticResource MicroText}" Text="(any private vanilla server, e.g. logon.myserver.com)" Margin="0,0,0,4"/>
              <TextBox x:Name="RealmlistBox" Margin="0,0,0,20"/>

              <TextBlock Style="{StaticResource Heading3Text}" Text="Client download URL"/>
              <TextBlock Style="{StaticResource MicroText}" Text="(advanced — override for another server's client zip)" Margin="0,0,0,4"/>
              <TextBox x:Name="ClientUrlBox" Margin="0,0,0,20"/>

              <TextBlock Style="{StaticResource Heading3Text}" Text="Login delay"/>
              <TextBlock Style="{StaticResource MicroText}" Text="Delay of the auto-login after the game window appears. (ms)" Margin="0,0,0,4"/>
              <TextBox x:Name="DelayBox" Width="130" HorizontalAlignment="Left" Margin="0,0,0,20"/>

              <TextBlock Style="{StaticResource Heading3Text}" Text="Ignored DLLs"/>
              <TextBlock Style="{StaticResource MicroText}"
                         Text="DLLs hidden from the DLLs tab's &quot;Detected in game folder&quot; list (e.g. files that aren't actually meant for injection). Un-ignore to make them detectable again."
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ListBox x:Name="IgnoredDllList" Height="100" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Un-ignore Selected" Click="OnUnignoreDlls"/>
                <Button Content="Un-ignore All" Click="OnUnignoreAllDlls" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- 6: Log -->
      <TabItem>
        <Border Background="#101014" Margin="8">
          <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C8C8D0"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>

    <!-- Fog overlay: shown while any of our own dialogs is open (ShowModal below), so the launcher
         behind a modal reads as "in the back" instead of looking identical to when it's active. Purely
         visual — WPF's Window.ShowDialog already disables/redirects focus for the owner on its own. -->
    <Border x:Name="ModalOverlay" Background="#A6101014" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Window>
